<UserControl x:Class="NovaErp.SalesDesk.Views.QuotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Style="{StaticResource ErpPrimaryButton}" Content="New quote (Ctrl+N)"
              Command="{Binding NewQuoteCommand}" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Style="{StaticResource ErpSecondaryButton}" Content="Refresh (F5)"
              Command="{Binding SearchCommand}" />
      <TextBox Style="{StaticResource ErpTextBox}" Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               Tag="Search quote no or customer…" />
    </DockPanel>
    <DataGrid Grid.Row="1" Style="{StaticResource ErpDataGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
              MouseDoubleClick="Grid_OnOpen" KeyDown="Grid_OnKeyDown">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Quote #" Binding="{Binding QuoteNo}" Width="120" />
        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
        <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource InrConverter}}" Width="120" />
        <DataGridTextColumn Header="Valid until" Binding="{Binding ValidUntil}" Width="140" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
