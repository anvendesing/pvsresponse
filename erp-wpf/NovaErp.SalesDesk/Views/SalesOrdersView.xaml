<UserControl x:Class="NovaErp.SalesDesk.Views.SalesOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Style="{StaticResource ErpPrimaryButton}" Content="Create pick list"
              Command="{Binding CreatePickListCommand}" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Style="{StaticResource ErpSecondaryButton}" Content="Refresh (F5)" Command="{Binding SearchCommand}" />
      <TextBox Style="{StaticResource ErpTextBox}" Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
    </DockPanel>
    <DataGrid Grid.Row="1" Style="{StaticResource ErpDataGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="SO #" Binding="{Binding SoNo}" Width="120" />
        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
        <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource InrConverter}}" Width="120" />
        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate}" Width="140" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
