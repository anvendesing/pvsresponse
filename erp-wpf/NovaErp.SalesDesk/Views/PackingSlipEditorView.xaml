<UserControl x:Class="NovaErp.SalesDesk.Views.PackingSlipEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource ErpSecondaryButton}" Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0" />
        <Button Style="{StaticResource ErpSecondaryButton}" Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
        <Button Style="{StaticResource ErpPrimaryButton}" Content="Pack &amp; invoice (F10)" Command="{Binding PackCommand}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="{Binding Status}" FontFamily="{StaticResource MonoFont}" />
      </StackPanel>
    </DockPanel>
    <DataGrid Grid.Row="1" Style="{StaticResource ErpDataGrid}" ItemsSource="{Binding Lines}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" IsReadOnly="True" />
        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="Picked" Binding="{Binding QtyPicked}" Width="80" IsReadOnly="True" />
        <DataGridTextColumn Header="Packed" Binding="{Binding QtyPacked, UpdateSourceTrigger=PropertyChanged}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
