<UserControl x:Class="NovaErp.SalesDesk.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Style="{StaticResource ErpToolbar}" Margin="-16,-16,-16,16" Padding="16,12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource ErpPrimaryButton}" Content="+ New customer" Command="{Binding StartCreateCommand}" Margin="8,0,0,0" />
        </StackPanel>
        <TextBox Style="{StaticResource ErpSearchBox}" MinWidth="320"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Tag="Search name, code, GST, city, pincode…" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Customer list -->
      <Border Grid.Column="0" Style="{StaticResource ErpCard}" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource CanvasBrush}" Padding="16,12" CornerRadius="12,12,0,0">
            <TextBlock Style="{StaticResource Caption}">
              <Run Text="Customers · " /><Run Text="{Binding Filtered.Count, Mode=OneWay}" /><Run Text=" shown (cached)" />
            </TextBlock>
          </Border>
          <ListBox ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource InkBrush}" />
                  <TextBlock FontSize="12" Foreground="{StaticResource InkMutedBrush}">
                    <Run Text="{Binding Code}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource PrimaryBrush}" />
                    <Run Text=" · " />
                    <Run Text="{Binding City}" />
                  </TextBlock>
                  <TextBlock FontSize="11" Foreground="{StaticResource InkMutedBrush}" Margin="0,2,0,0">
                    <Run Text="AR ₹" /><Run Text="{Binding OpenBalance, StringFormat=N2}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Detail / create -->
      <Grid Grid.Column="2">
        <!-- Create form -->
        <Border Style="{StaticResource ErpCard}" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel MaxWidth="560">
            <TextBlock Text="New customer" Style="{StaticResource H2}" Margin="0,0,0,20" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
            <TextBox Style="{StaticResource ErpTextBox}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Address" />
            <TextBox Style="{StaticResource ErpTextBox}" Text="{Binding NewAddressLine, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="100" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="City" />
                <TextBox Style="{StaticResource ErpTextBox}" Text="{Binding NewCity, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="State" />
                <TextBox Style="{StaticResource ErpTextBox}" Text="{Binding NewState, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Pincode" />
                <TextBox Style="{StaticResource ErpTextBox}" Text="{Binding NewPincode, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Contact" />
            <TextBox Style="{StaticResource ErpTextBox}" Text="{Binding NewContact, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="GSTIN" />
            <TextBox Style="{StaticResource ErpTextBox}" Text="{Binding NewGst, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Credit limit (₹)" />
            <TextBox Style="{StaticResource ErpTextBox}" Text="{Binding NewCreditLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource ErpPrimaryButton}" Content="Create customer" Command="{Binding SaveNewCustomerCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource ErpSecondaryButton}" Content="Cancel" Command="{Binding CancelCreateCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Detail panel -->
        <Grid Visibility="{Binding IsCreating, Converter={StaticResource InverseBoolToVisibilityConverter}}">
          <Border Style="{StaticResource ErpCard}" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
              <TextBlock Text="Select a customer" Style="{StaticResource H3}" HorizontalAlignment="Center" />
              <TextBlock Text="Search as you type — list filters instantly from cached data. AR statement and payments load once per customer." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource InkMutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource ErpCard}" Margin="0,0,0,16">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DetailName}" Style="{StaticResource H2}" />
                    <TextBlock Margin="0,4,0,0">
                      <Run Text="{Binding DetailCode}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                      <Run Text=" · " Foreground="{StaticResource InkMutedBrush}" />
                      <Run Text="{Binding DetailSubtitle}" Foreground="{StaticResource InkMutedBrush}" />
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}">
                      <Run Text="GSTIN " /><Run Text="{Binding DetailGst}" FontFamily="{StaticResource MonoFont}" />
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Caption}"
                             Text="{Binding IsLoadingDetail, Converter={StaticResource LoadingHintConverter}}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                  <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                    <StackPanel>
                      <TextBlock Text="OPEN AR" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding ArBalance, Converter={StaticResource InrConverter}, StringFormat=₹ {0}}" Style="{StaticResource AmountLarge}" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                    <StackPanel>
                      <TextBlock Text="AVAILABLE CREDIT" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding AvailableCredit, Converter={StaticResource InrConverter}, StringFormat=₹ {0}}" Style="{StaticResource AmountLarge}" Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                      <TextBlock Text="CREDIT LIMIT" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding CreditLimitText}" Style="{StaticResource AmountLarge}" FontSize="20" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ErpCard}" Padding="16">
              <TabControl>
                <TabItem Header="AR statement">
                  <DataGrid Style="{StaticResource ErpDataGrid}" ItemsSource="{Binding StatementEntries}" IsReadOnly="True" Margin="0,8,0,0">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100" />
                      <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
                      <DataGridTextColumn Header="Ref" Binding="{Binding Ref}" Width="100" />
                      <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                      <DataGridTextColumn Header="Debit" Binding="{Binding Debit, Converter={StaticResource InrConverter}}" Width="100" />
                      <DataGridTextColumn Header="Credit" Binding="{Binding Credit, Converter={StaticResource InrConverter}}" Width="100" />
                      <DataGridTextColumn Header="Balance" Binding="{Binding Balance, Converter={StaticResource InrConverter}}" Width="110" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
                <TabItem Header="Payments">
                  <DataGrid Style="{StaticResource ErpDataGrid}" ItemsSource="{Binding Payments}" IsReadOnly="True" Margin="0,8,0,0">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Payment #" Binding="{Binding PaymentNo}" Width="120" />
                      <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate}" Width="120" />
                      <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="100" />
                      <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource InrConverter}}" Width="120" />
                      <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
              </TabControl>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
  </Grid>
</UserControl>
