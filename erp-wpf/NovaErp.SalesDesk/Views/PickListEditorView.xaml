<UserControl x:Class="NovaErp.SalesDesk.Views.PickListEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource ErpSecondaryButton}" Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0" />
        <Button Style="{StaticResource ErpSecondaryButton}" Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
        <Button Style="{StaticResource ErpPrimaryButton}" Content="Complete pick (F10)" Command="{Binding CompleteCommand}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="{Binding CustomerLine}" Foreground="{StaticResource InkMutedBrush}" />
        <TextBlock Text="{Binding Status}" FontFamily="{StaticResource MonoFont}" />
      </StackPanel>
    </DockPanel>
    <DataGrid Grid.Row="1" Style="{StaticResource ErpDataGrid}" ItemsSource="{Binding Lines}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Bin" Binding="{Binding BinPath}" Width="120" IsReadOnly="True" />
        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" IsReadOnly="True" />
        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="To pick" Binding="{Binding QtyToPick}" Width="80" IsReadOnly="True" />
        <DataGridTextColumn Header="Picked" Binding="{Binding QtyPicked, UpdateSourceTrigger=PropertyChanged}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0" />
  </Grid>
</UserControl>
