<Window x:Class="NovaErp.SalesDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NovaErp.SalesDesk.ViewModels"
        xmlns:views="clr-namespace:NovaErp.SalesDesk.Views"
        Title="NovaERP Sales Desk"
        Height="920" Width="1440"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:QuotesViewModel}"><views:QuotesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:QuoteEditorViewModel}"><views:QuoteEditorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SalesOrdersViewModel}"><views:SalesOrdersView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PickListsViewModel}"><views:PickListsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PickListEditorViewModel}"><views:PickListEditorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PackingSlipsViewModel}"><views:PackingSlipsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PackingSlipEditorViewModel}"><views:PackingSlipEditorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView /></DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Top command bar — matches TopCommandBar.tsx h-14 -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0" Height="56">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource StatusChip}" Margin="0,0,12,0">
            <TextBlock Text="{Binding UserLine}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
          </Border>
          <Button Style="{StaticResource ErpGhostButton}" Content="Sign out" Command="{Binding LogoutCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
            <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
            <TextBlock Text="NovaERP" FontWeight="Bold" FontSize="14" Foreground="{StaticResource InkBrush}" />
            <TextBlock Text="Sales Desk" FontSize="11" Foreground="{StaticResource InkMutedBrush}" />
          </StackPanel>
          <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H3}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Bottom status bar — matches BottomStatusBar.tsx -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PrimaryBrush}" Height="28" Padding="12,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Scanner ready" Foreground="#CCFFFFFF" FontSize="11" FontWeight="Medium" Margin="0,0,16,0" />
          <TextBlock Text="v1.0.0 · Sales Desk" Foreground="#CCFFFFFF" FontSize="11" FontWeight="Medium" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding BackendOnline, Converter={StaticResource OnlineTextConverter}}" Foreground="White" FontSize="11" FontWeight="Medium" />
          <TextBlock Text="  |  " Foreground="#55FFFFFF" FontSize="11" />
          <TextBlock Foreground="White" FontSize="11" FontWeight="Medium">
            <Run Text="API " /><Run Text="{Binding ApiLatencyMs, Mode=OneWay}" /><Run Text="ms" />
          </TextBlock>
          <TextBlock Text="  |  " Foreground="#55FFFFFF" FontSize="11" />
          <TextBlock Text="Catalog cached · instant search" Foreground="#CCFFFFFF" FontSize="11" FontWeight="Medium" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="224" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left navigation — matches LeftNavigation.tsx -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="0,8,0,0">
          <RadioButton Style="{StaticResource SidebarNavButton}" Content="  Quotes" GroupName="nav" IsChecked="True" Command="{Binding ShowQuotesCommand}" />
          <RadioButton Style="{StaticResource SidebarNavButton}" Content="  Sales Orders" GroupName="nav" Command="{Binding ShowSalesOrdersCommand}" />
          <RadioButton Style="{StaticResource SidebarNavButton}" Content="  Picking" GroupName="nav" Command="{Binding ShowPickListsCommand}" />
          <RadioButton Style="{StaticResource SidebarNavButton}" Content="  Packing" GroupName="nav" Command="{Binding ShowPackingSlipsCommand}" />
          <RadioButton Style="{StaticResource SidebarNavButton}" Content="  Customers" GroupName="nav" Command="{Binding ShowCustomersCommand}" />
          <Border Height="1" Background="{StaticResource BorderBrush}" Margin="12,12" />
          <TextBlock Text="Shortcuts" Style="{StaticResource Caption}" Margin="16,0,16,6" />
          <ItemsControl ItemsSource="{Binding ShortcutHints}" Margin="12,0,12,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource ShortcutHint}" TextWrapping="Wrap" Margin="0,0,0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Main content -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
          <TextBlock Text="{Binding Current.StatusMessage, FallbackValue=''}" Foreground="{StaticResource SuccessBrush}" FontSize="12" />
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
          <ContentControl Content="{Binding Current}" />
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
