<Application x:Class="NovaErp.SalesDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NovaErp.SalesDesk.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/ErpTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
      <conv:OnlineTextConverter x:Key="OnlineTextConverter" />
      <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
      <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <conv:InrConverter x:Key="InrConverter" />
      <conv:LoadingHintConverter x:Key="LoadingHintConverter" />
      <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
