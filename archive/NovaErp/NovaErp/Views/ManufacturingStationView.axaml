<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NovaErp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="700"
             x:Class="NovaErp.Views.ManufacturingStationView"
             x:DataType="vm:ManufacturingStationViewModel">
  <Grid Margin="20" RowDefinitions="Auto,*">
    <StackPanel Spacing="6">
      <TextBlock Classes="caption" Text="MANUFACTURING STATION" />
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="h1" Text="Production Console" />
          <TextBlock Classes="muted" Text="{Binding StatusMessage}" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0 24 0 0" ColumnDefinitions="320,*">
      <Border Classes="card" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource CanvasBrush}" Padding="14 10"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0 0 0 1">
            <TextBlock Text="Active Orders" FontWeight="SemiBold" />
          </Border>
          <ListBox ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="6" ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding OrderNo}" FontFamily="Consolas" FontSize="11"
                               FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="{Binding Station}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Classes="caption">
                      <Run Text="{Binding ActualQty, StringFormat='{}{0:N0}'}" />/<Run Text="{Binding PlannedQty, StringFormat='{}{0:N0}'}" />
                    </TextBlock>
                  </StackPanel>
                  <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" Margin="16 0 0 0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <Border Classes="card" Padding="20" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Classes="caption" Text="{Binding Selected.OrderNo, StringFormat='ORDER {0}'}" />
                  <TextBlock Classes="h2" Text="{Binding Selected.Station}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="chip primary" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Selected.Status}" FontWeight="SemiBold" FontSize="12"
                             Foreground="{DynamicResource PrimaryBrush}" />
                </Border>
              </Grid>

              <UniformGrid Columns="4">
                <Border Background="{DynamicResource CanvasBrush}" CornerRadius="6" Padding="12" Margin="0 0 6 0">
                  <StackPanel>
                    <TextBlock Classes="caption" Text="PLANNED" />
                    <TextBlock Text="{Binding Selected.PlannedQty, StringFormat='{}{0:N0}'}" Classes="amount" />
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Primary50Brush}" CornerRadius="6" Padding="12" Margin="3 0">
                  <StackPanel>
                    <TextBlock Classes="caption" Text="ACTUAL" Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="{Binding Selected.ActualQty, StringFormat='{}{0:N0}'}" Classes="amount"
                               Foreground="{DynamicResource PrimaryBrush}" />
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="6" Padding="12" Margin="3 0">
                  <StackPanel>
                    <TextBlock Classes="caption" Text="SCRAP" Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Text="{Binding Selected.ScrapQty, StringFormat='{}{0:N0}'}" Classes="amount"
                               Foreground="{DynamicResource DangerBrush}" />
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="12" Margin="6 0 0 0">
                  <StackPanel>
                    <TextBlock Classes="caption" Text="REWORK" />
                    <TextBlock Text="{Binding Selected.ReworkQty, StringFormat='{}{0:N0}'}" Classes="amount" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="+10 units" Command="{Binding IncrementOutputCommand}" />
                <Button Classes="secondary" Content="Pause station" />
                <Button Classes="gold" Content="Move to QC · F8" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="20" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="10">
              <TextBlock Text="BOM consumption (illustrative)" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="Rolls back into stock ledger via sync. Server reconciles." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
