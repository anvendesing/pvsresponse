<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NovaErp.ViewModels"
             xmlns:views="using:NovaErp.Views"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="700"
             x:Class="NovaErp.Views.AttendanceView"
             x:DataType="vm:AttendanceViewModel">
  <UserControl.Resources>
    <views:StringEqualsConverter x:Key="StringEquals" />
  </UserControl.Resources>

  <Grid Margin="20" RowDefinitions="Auto,*">
    <StackPanel Spacing="6">
      <TextBlock Classes="caption" Text="WORKER ATTENDANCE" />
      <TextBlock Classes="h1" Text="Punch In / Out" />
      <TextBlock Classes="muted" Text="{Binding StatusMessage}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0 24 0 0" Spacing="16" MaxWidth="540" HorizontalAlignment="Left">
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Text="Employee number / badge" Classes="caption" />
            <TextBox Classes="scan" Text="{Binding EmpNo}"
                     Watermark="Scan badge or type EMP1001…" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="In" Padding="20 0" Height="44" CornerRadius="8"
                    Command="{Binding SetDirectionCommand}" CommandParameter="in"
                    Classes.primary="{Binding Direction, Converter={StaticResource StringEquals}, ConverterParameter='in'}" />
            <Button Content="Break" Padding="20 0" Height="44" CornerRadius="8"
                    Command="{Binding SetDirectionCommand}" CommandParameter="break"
                    Classes.primary="{Binding Direction, Converter={StaticResource StringEquals}, ConverterParameter='break'}" />
            <Button Content="Out" Padding="20 0" Height="44" CornerRadius="8"
                    Command="{Binding SetDirectionCommand}" CommandParameter="out"
                    Classes.primary="{Binding Direction, Converter={StaticResource StringEquals}, ConverterParameter='out'}" />
          </StackPanel>

          <Button Classes="primary" Content="Punch · F8"
                  Command="{Binding PunchCommand}" HotKey="F8" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
