<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NovaErp.ViewModels"
             xmlns:views="using:NovaErp.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
             x:Class="NovaErp.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <UserControl.Resources>
    <views:InvertBoolConverter x:Key="InvertBool" />
  </UserControl.Resources>

  <Grid ColumnDefinitions="*,*">
    <!-- Brand panel -->
    <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}" Padding="48">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="32">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="44" Height="44" CornerRadius="8" Background="White">
              <TextBlock Text="N" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"
                         FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="NovaERP" Foreground="White" FontWeight="Bold" FontSize="20" />
              <TextBlock Text="HIGH-PERFORMANCE MANUFACTURING" Foreground="#A0B7E4"
                         FontSize="11" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Built for the" Foreground="White" FontSize="40" FontWeight="Bold" />
            <TextBlock Text="shop floor." Foreground="White" FontSize="40" FontWeight="Bold" />
            <TextBlock Text="Keyboard-first, scanner-first ERP for warehouse, manufacturing, procurement, and billing. Operates online or offline at industrial speed."
                       Foreground="#D5DEF1" TextWrapping="Wrap" MaxWidth="420" Margin="0 16 0 0" />
          </StackPanel>
        </StackPanel>

        <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0 24 0 0">
          <Border Background="#1A2E5A" CornerRadius="8" Padding="14" Margin="0 0 8 0">
            <StackPanel>
              <TextBlock Text="AVG. SCAN" Foreground="#A0B7E4" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="&lt;50ms" Foreground="White" FontSize="20" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <Border Background="#1A2E5A" CornerRadius="8" Padding="14" Margin="4 0">
            <StackPanel>
              <TextBlock Text="SCREEN SWITCH" Foreground="#A0B7E4" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="&lt;200ms" Foreground="White" FontSize="20" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <Border Background="#1A2E5A" CornerRadius="8" Padding="14" Margin="8 0 0 0">
            <StackPanel>
              <TextBlock Text="OFFLINE READY" Foreground="#A0B7E4" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="100%" Foreground="White" FontSize="20" FontWeight="Bold" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </DockPanel>
    </Border>

    <!-- Form -->
    <Grid Grid.Column="1" Background="{DynamicResource CanvasBrush}">
      <StackPanel Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
        <TextBlock Classes="h1" Text="Sign in" />
        <TextBlock Text="Enter your credentials to start your shift." Classes="muted" />

        <!-- Mode toggle -->
        <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="4" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Content="Password" Padding="14 0" Height="28" CornerRadius="6"
                    Command="{Binding ToggleModeCommand}"
                    IsEnabled="{Binding UsePin}" />
            <Button Content="PIN (Operator)" Padding="14 0" Height="28" CornerRadius="6"
                    Command="{Binding ToggleModeCommand}"
                    IsEnabled="{Binding UsePin, Converter={StaticResource InvertBool}}" />
          </StackPanel>
        </Border>

        <!-- Password mode -->
        <StackPanel IsVisible="{Binding UsePin, Converter={StaticResource InvertBool}}" Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="Username" FontWeight="Medium" FontSize="12" />
            <TextBox Classes="input" Text="{Binding Username}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Password" FontWeight="Medium" FontSize="12" />
            <TextBox Classes="input" Text="{Binding Password}" PasswordChar="•" />
          </StackPanel>
          <Button Classes="primary" Content="Sign in to NovaERP" HorizontalAlignment="Stretch"
                  Command="{Binding SignInCommand}" />
        </StackPanel>

        <!-- PIN mode -->
        <StackPanel IsVisible="{Binding UsePin}" Spacing="10">
          <TextBlock Text="6-digit operator PIN" Classes="caption" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Pin}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                     FontFamily="Consolas" Foreground="{DynamicResource PrimaryBrush}" Height="44"
                     TextAlignment="Center" />
          <UniformGrid Columns="3" Rows="4" Width="280" HorizontalAlignment="Center">
            <Button Content="1" Margin="3" Height="48" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="18" FontWeight="Bold" Command="{Binding TapPinCommand}" CommandParameter="1" />
            <Button Content="2" Margin="3" Height="48" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="18" FontWeight="Bold" Command="{Binding TapPinCommand}" CommandParameter="2" />
            <Button Content="3" Margin="3" Height="48" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="18" FontWeight="Bold" Command="{Binding TapPinCommand}" CommandParameter="3" />
            <Button Content="4" Margin="3" Height="48" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="18" FontWeight="Bold" Command="{Binding TapPinCommand}" CommandParameter="4" />
            <Button Content="5" Margin="3" Height="48" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="18" FontWeight="Bold" Command="{Binding TapPinCommand}" CommandParameter="5" />
            <Button Content="6" Margin="3" Height="48" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="18" FontWeight="Bold" Command="{Binding TapPinCommand}" CommandParameter="6" />
            <Button Content="7" Margin="3" Height="48" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="18" FontWeight="Bold" Command="{Binding TapPinCommand}" CommandParameter="7" />
            <Button Content="8" Margin="3" Height="48" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="18" FontWeight="Bold" Command="{Binding TapPinCommand}" CommandParameter="8" />
            <Button Content="9" Margin="3" Height="48" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="18" FontWeight="Bold" Command="{Binding TapPinCommand}" CommandParameter="9" />
            <Button Content="Clear" Margin="3" Height="48" CornerRadius="8" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="12" FontWeight="SemiBold" Command="{Binding ClearPinCommand}" />
            <Button Content="0" Margin="3" Height="48" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="18" FontWeight="Bold" Command="{Binding TapPinCommand}" CommandParameter="0" />
            <Button Content="⌫" Margin="3" Height="48" CornerRadius="8" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="14" FontWeight="SemiBold" Command="{Binding BackspacePinCommand}" />
          </UniformGrid>
        </StackPanel>

        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="6" Padding="10 6"
                IsVisible="{Binding Error, Converter={x:Static views:StringMinLengthConverter.Instance}, ConverterParameter=1}">
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" />
        </Border>

        <TextBlock Classes="caption" HorizontalAlignment="Center" Margin="0 8 0 0">
          End-to-end encrypted · v1.0.0
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
