# Local development — PostgreSQL (recommended, matches production):
# DATABASE_URL="postgresql://novaerp:novaerp@localhost:5432/novaerp?schema=public"
#
# SQLite fallback for dev (no Postgres required locally):
# DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://novaerp:novaerp@localhost:5432/novaerp?schema=public"

# Production: generate a strong password
# openssl rand -hex 32
POSTGRES_PASSWORD="novaerp"

JWT_SECRET="change-me-in-production"
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173"

# Storefront (pvsecommerce on :5174)
STOREFRONT_ORIGIN="http://localhost:5174"
PUBLIC_API_BASE="http://localhost:4000"

# Redis cache (optional for local dev — omit to disable gracefully)
REDIS_URL="redis://localhost:6379/0"

# Razorpay (optional — or configure in ERP Settings → Payment (Razorpay))
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# PayU (optional — or configure in ERP Settings → Payment (PayU))
# PAYU_MERCHANT_KEY=""
# PAYU_SALT=""
# PAYU_MODE="test"

# Shiprocket shipping quotes (optional — or ERP Settings → Shipping (Shiprocket))
# SHIPROCKET_EMAIL=""
# SHIPROCKET_PASSWORD=""
# SHIPROCKET_PICKUP_PINCODE="517132"
