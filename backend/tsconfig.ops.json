{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "dist/ops-scripts",
    "rootDir": "ops-scripts",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": false,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["ops-scripts/**/*"]
}
