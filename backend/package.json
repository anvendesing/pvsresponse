{
  "name": "novaerp-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "npm run openapi:generate && tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('openapi.json','dist/openapi.json')\"",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-stock-room": "node dist/scripts/seed-stock-room-bins.js",
    "db:seed-stock-room:dev": "tsx src/scripts/seed-stock-room-bins.ts",
    "db:backfill-ecommerce-payments": "node dist/scripts/backfill-ecommerce-payments.js",
    "db:sync-stock": "node dist/scripts/sync-stock-from-bins.js",
    "db:sync-stock:dev": "tsx src/scripts/sync-stock-from-bins.ts",
    "db:import-catalog": "node dist/scripts/import-catalog.js",
    "db:export-catalog": "tsx src/scripts/export-catalog.ts",
    "db:reset-test-env": "tsx src/scripts/reset-test-environment.ts",
    "db:reset-test-env:dist": "node dist/scripts/reset-test-environment.js",
    "ops:warehouses": "tsx ops-scripts/01-warehouses.ts",
    "ops:production-lines": "tsx ops-scripts/02-production-lines.ts",
    "ops:site-setup": "tsx ops-scripts/run-all.ts",
    "ops:putaway-fg": "tsx ops-scripts/03-putaway-fg.ts",
    "ops:warehouses:dist": "node dist/ops-scripts/01-warehouses.js",
    "ops:production-lines:dist": "node dist/ops-scripts/02-production-lines.js",
    "ops:site-setup:dist": "node dist/ops-scripts/run-all.js",
    "ops:putaway-fg:dist": "node dist/ops-scripts/03-putaway-fg.js",
    "db:wipe": "tsx prisma/wipe.ts",
    "db:import-pricelists": "tsx scripts/import-pricelists.ts",
    "db:backfill-variant-barcodes": "tsx scripts/backfill-variant-barcodes-from-pricelist.ts",
    "db:backfill-multi-container": "tsx scripts/backfill-multi-container.ts",
    "db:backfill-customer-addresses": "node dist/scripts/backfill-customer-addresses.js",
    "db:clear-stock-room-zone:dev": "tsx scripts/clear-stock-room-zone.ts",
    "db:prune-warehouse-zones:dev": "tsx src/scripts/prune-warehouse-zones.ts",
    "db:prune-warehouse-zones": "node dist/scripts/prune-warehouse-zones.js",
    "db:sync-warehouse-layout:dev": "npm run db:prune-warehouse-zones:dev && npm run db:seed-farm-shop:dev && npm run db:seed-stock-room:dev",
    "db:sync-warehouse-layout": "npm run db:prune-warehouse-zones && npm run db:seed-farm-shop && npm run db:seed-stock-room",
    "ops:warehouse-layout": "tsx ops-scripts/04-warehouse-layout.ts",
    "ops:warehouse-layout:dist": "node dist/ops-scripts/04-warehouse-layout.js",
    "labels:bins": "tsx scripts/generate-bin-labels-pdf.ts",
    "labels:soap-room": "tsx scripts/seed-soap-room-bins.ts && tsx scripts/generate-soap-room-bin-labels-pdf.ts",
    "db:seed-farm-shop:dev": "tsx src/scripts/seed-farm-shop-bins.ts",
    "db:seed-farm-shop": "node dist/scripts/seed-farm-shop-bins.js",
    "labels:farm-shop": "npm run db:seed-farm-shop:dev && tsx scripts/generate-farm-shop-bin-labels-pdf.ts",
    "labels:stock-room": "npm run db:seed-stock-room:dev && tsx scripts/generate-stock-room-bin-labels-pdf.ts",
    "labels:stock-room:zone-b": "npm run db:seed-stock-room:dev && tsx scripts/generate-stock-room-bin-labels-pdf.ts --zone B",
    "labels:stock-room:b-s17-a": "npm run db:seed-stock-room:dev && tsx scripts/generate-stock-room-bin-labels-pdf.ts --set b-s17-a",
    "labels:test": "tsx scripts/generate-test-labels-pdf.ts",
    "labels:containers": "tsx scripts/generate-container-labels-pdf.ts",
    "setup": "prisma generate && prisma migrate dev --name init && tsx prisma/seed.ts && tsx scripts/import-pricelists.ts",
    "lint": "tsc --noEmit",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.6",
    "bwip-js": "^4.10.2",
    "pdfkit": "^0.18.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
