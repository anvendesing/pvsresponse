// NovaERP — Prisma schema
//
// Production uses PostgreSQL. For local dev, set DATABASE_URL to a local
// Postgres instance or the SQLite fallback (see .env.example).
// The schema is portable between both engines.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Auth & Identity
// =====================================================================

model User {
  id                  String            @id @default(cuid())
  username            String            @unique
  passwordHash        String
  pin                 String? // 6-digit operator PIN (hashed)
  name                String
  role                String // admin | supervisor | warehouse | procurement | billing | worker
  email               String?           @unique
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]
  // Reverse relations for warehouse-mobile features
  worker              Worker?           @relation("WorkerUser")
  pickListClaims      PickList[]        @relation("PickListAssignee")
  packingSlipClaims   PackingSlip[]     @relation("PackingSlipAssignee")
  binCounts           BinCount[]
  scanEvents          ScanEvent[]
  transferOrderClaims TransferOrder[]   @relation("TransferOrderAssignee")
  transferOrderPicks  TransferOrder[]   @relation("TransferOrderPicker")
  transferOrderDrops  TransferOrder[]   @relation("TransferOrderDropper")
  enquiriesAssigned   Enquiry[]         @relation("EnquiryAssignee")
  enquiriesCreated    Enquiry[]         @relation("EnquiryCreator")
  enquiryActivities   EnquiryActivity[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  device     String
  ip         String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// =====================================================================
// Master Data
// =====================================================================

// ---------------------------------------------------------------------
// Units of Measure (UoM) - Odoo-style master.
//
// Each UoM belongs to a category (Weight, Volume, Length, Unit, ...).
// Within a category one UoM is the "reference" (e.g. kg for Weight, L
// for Volume) with factor 1.0; every other UoM stores its conversion
// factor relative to that reference.
//
//   factor = "how many reference units are in 1 of THIS uom"
//
//   For example in Weight (ref = kg):
//     kg.factor = 1.0       (1 kg = 1 kg)
//     g.factor  = 0.001     (1 g  = 0.001 kg)
//     t.factor  = 1000.0    (1 t  = 1000 kg)
//
// Conversion between any two UoMs in the same category:
//   qtyB = qtyA * (uomA.factor / uomB.factor)
//
// Cross-category conversion is forbidden (system rejects).
//
// This unblocks consistent display, BOM components in different units
// than their parent product (e.g. parent in kg, scrap in g), and
// purchase/sales in different units than stock.
// ---------------------------------------------------------------------
model UomCategory {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "weight", "volume", "length", "unit"
  name        String // e.g. "Weight", "Volume", "Length", "Unit"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  uoms        Uom[]
}

model Uom {
  id          String      @id @default(cuid())
  // Canonical short code stored in records (e.g. "kg", "g", "L", "mL",
  // "m", "cm", "pc", "dozen"). Lower-cased ISO style where possible.
  code        String      @unique
  // Display name e.g. "Kilogram", "Litre", "Piece".
  name        String
  // Conversion factor relative to the category reference UoM.
  factor      Float       @default(1.0)
  // True for the one reference UoM in each category. Enforced in
  // application code: at most one Uom per category may be reference.
  isReference Boolean     @default(false)
  // Whether this UoM is offered to users in dropdowns. Inactive UoMs
  // are kept for historical records but not picked for new entries.
  active      Boolean     @default(true)
  // For sorting in pickers (lower = shown first).
  rounding    Float       @default(0.001)
  categoryId  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  category    UomCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model Warehouse {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  city               String
  // Short scan alias for compact bin barcodes (2–4 chars, e.g. WSP for WH-PROD-SOAP).
  // When set, bin labels use WSP.AS05.11 instead of B.WH-PROD-SOAP.A.S05.11.
  scanPrefix         String?             @unique
  // "storage" = normal stock warehouse; "production" = production-line holding area
  // Each ProductionFacility optionally owns one production warehouse.
  kind               String              @default("storage")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bins               Bin[]
  ledger             StockLedger[]
  // Reverse relation: the ProductionFacility that owns this production warehouse
  productionFacility ProductionFacility? @relation("FacilityProductionWarehouse")
  putawayRulesTo     PutawayRule[]       @relation("PutawayRuleTo")
  stockRulesTo       StockRule[]         @relation("StockRuleToWarehouse")
  transferOrdersFrom TransferOrder[]     @relation("TransferOrderFromWarehouse")
  transferOrdersTo   TransferOrder[]     @relation("TransferOrderToWarehouse")
  stockLots          StockLot[]
}

model Bin {
  id                     String                  @id @default(cuid())
  warehouseId            String
  zone                   String
  shelf                  String
  bin                    String
  // Mobile-scan code. Compact when warehouse.scanPrefix is set:
  //   WSP.AS05.11  (prefix + zone+shelf merged + bin)
  // Legacy otherwise:
  //   B.<warehouseCode>.<zone>.<shelf>.<bin>
  code                   String?                 @unique
  capacity               Int                     @default(100)
  occupied               Int                     @default(0)
  productId              String?
  // The specific variant of `productId` this bin physically holds.
  // Optional because (a) products without variants put units straight
  // into bins with `variantId = null`, and (b) legacy bins from before
  // we tracked variants are left untagged. `splitAcrossBins`,
  // `computeAtp` and `/inventory/locations` honour this column when
  // present so a 1KG-pack bin and a 500g-pack bin under the same
  // parent product no longer get conflated.
  variantId              String?
  qty                    Int                     @default(0)
  // Quantity reserved by completed pick lists but not yet shipped.
  // Free-to-pick = qty - reservedQty. This prevents double-picking the
  // same physical stock from a bin while pack/dispatch is pending.
  reservedQty            Int                     @default(0)
  batch                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  warehouse              Warehouse               @relation(fields: [warehouseId], references: [id])
  product                Product?                @relation(fields: [productId], references: [id])
  variant                ProductVariant?         @relation(fields: [variantId], references: [id])
  pickListItems          PickListItem[]
  binCounts              BinCount[]
  putawayRules           PutawayRule[]
  stockRulesMonitor      StockRule[]             @relation("StockRuleMonitor")
  stockRulesSource       StockRule[]             @relation("StockRuleSource")
  stockRulesDest         StockRule[]             @relation("StockRuleDest")
  salesOrderReservations SalesOrderReservation[]
  transferItemsFrom      TransferOrderItem[]     @relation("TransferItemFromBin")
  transferItemsTo        TransferOrderItem[]     @relation("TransferItemToBin")
  stockLots              StockLot[]

  @@unique([warehouseId, zone, shelf, bin])
  @@index([productId])
}

model ProductCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// Storefront "Shop by Concern" buckets (Diabetes, Heart Health, …).
// Unlike ProductCategory, a product may belong to many concerns.
model ProductConcern {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int                  @default(0)
  active      Boolean              @default(true)
  imageUrl    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  products    ProductConcernLink[]
}

model ProductConcernLink {
  productId String
  concernId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  concern   ProductConcern @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([productId, concernId])
  @@index([concernId])
  @@index([productId])
}

model Product {
  id                 String               @id @default(cuid())
  sku                String               @unique
  name               String
  type               String // raw | semi | finished | consumable | service
  uom                String
  barcode            String               @unique
  state              String               @default("active") // draft | active | discontinued | blocked
  categoryId         String?
  category           ProductCategory?     @relation(fields: [categoryId], references: [id])
  hsn                String
  gstRate            Float                @default(18) // GST percentage e.g. 18 = 18%
  costPrice          Float
  sellingPrice       Float
  reorderLevel       Int                  @default(0)
  stockOnHand        Int                  @default(0)
  batchTracked       Boolean              @default(false)
  // Gross weight (kg) of one sellable unit at parent UoM. Used to
  // estimate packing-container weights, which roll up into the trip
  // load. Variant.weightKg overrides this when set. Optional - items
  // with no weight simply contribute 0 to container estimates and the
  // packer can correct with an actual scale reading on the container.
  weightKg           Float?
  // Storefront-facing copy
  description        String? // short product description shown on detail page
  ingredients        String? // free-form ingredients / what's inside text
  tags               String? // comma-separated search/filter tags
  searchAliases      String? // comma-separated alternate/regional names (e.g. "amla, gooseberry, usiri")
  imageHint          String? // e.g. "oils" | "millets" | "soap" for PackagingArt
  imageUrl           String? // optional product photo path (relative to API origin) e.g. /uploads/products/abc.jpg
  // When false, hidden from storefront / ecommerce catalog UIs.
  ecommerceEnabled   Boolean              @default(true)
  // When false, hidden from price list editor and bulk-order Excel export.
  priceListEnabled   Boolean              @default(true)
  // When true, featured on the storefront home "Best Selling Products" grid.
  bestSellerEnabled  Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  bins               Bin[]
  bomItems           BomItem[]
  bomByproducts      BomByproduct[]
  bomsAsParent       Bom[]
  ledger             StockLedger[]
  poItems            PurchaseOrderItem[]
  invoiceItems       InvoiceItem[]
  variants           ProductVariant[]
  quoteItems         QuoteItem[]
  salesOrderItems    SalesOrderItem[]
  pickListItems      PickListItem[]
  returnItems        CustomerReturnItem[]
  creditNoteItems    CreditNoteItem[]
  packingSlipItems   PackingSlipItem[]
  priceListItems     PriceListItem[]
  putawayRules       PutawayRule[]
  stockRules         StockRule[]
  concernLinks       ProductConcernLink[]
  transferOrderItems TransferOrderItem[]
  enquiryItems       EnquiryItem[]
  stockLots          StockLot[]
  vendorProducts     VendorProduct[]
}

model ProductVariant {
  id                   String               @id @default(cuid())
  productId            String
  sku                  String               @unique
  barcode              String?              @unique
  // Optional per-variant HSN and GST rate. Null = inherit from parent product.
  hsn                  String?
  gstRate              Float? // override; null = inherit parent.gstRate
  // Free-form variant axes (size / color / grade per PRD).
  size                 String?
  color                String?
  grade                String?
  // Selling unit-of-measure for the variant. Null = inherit from parent.
  // Pattern: parent holds bulk (e.g. coconut oil parent in "L"); each
  // variant defines its sellable unit (e.g. "1L bottle" sold as "pc",
  // "100g pouch" sold as "pc"). Selling and billing use this column;
  // parent.uom is reserved for bulk stock monitoring and price tracking.
  uom                  String?
  // Conversion factor: how many parent.uom units one variant unit
  // represents. Used to roll variant sales up to bulk consumption.
  // Defaults to 1 (variant unit == parent unit, the trivial case).
  // Examples:
  //   variant "1L bottle"  on parent uom "L"  -> packSize 1
  //   variant "5L can"     on parent uom "L"  -> packSize 5
  //   variant "100g pouch" on parent uom "kg" -> packSize 0.1
  packSize             Float                @default(1)
  // Gross weight (kg) of one variant unit. Overrides Product.weightKg
  // when set. Drives container-weight estimation -> dispatch weight ->
  // trip load. Null = inherit Product.weightKg (which may itself be
  // null, in which case the variant contributes 0 to estimates).
  weightKg             Float?
  // Optional price overrides; null = inherit from parent product.
  costPriceOverride    Float?
  sellingPriceOverride Float?
  stockOnHand          Int                  @default(0)
  active               Boolean              @default(true)
  // Channel visibility — independent of `active` (operational) flag.
  ecommerceEnabled     Boolean              @default(true)
  priceListEnabled     Boolean              @default(true)
  // Optional per-variant image (falls back to parent Product.imageUrl at read time).
  imageUrl             String? // relative path e.g. /uploads/products/variants/<id>.jpg
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  product              Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  invoiceItems         InvoiceItem[]
  quoteItems           QuoteItem[]
  salesOrderItems      SalesOrderItem[]
  pickListItems        PickListItem[]
  packingSlipItems     PackingSlipItem[]
  priceListItems       PriceListItem[]
  boms                 Bom[]
  bomByproducts        BomByproduct[]
  returnItems          CustomerReturnItem[]
  creditNoteItems      CreditNoteItem[]
  putawayRules         PutawayRule[]
  stockRules           StockRule[]
  transferOrderItems   TransferOrderItem[]
  enquiryItems         EnquiryItem[]
  ledger               StockLedger[]
  bins                 Bin[]
  stockLots            StockLot[]
  vendorProducts       VendorProduct[]

  @@index([productId])
}

model Vendor {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  gst          String
  contact      String
  // Optional contact details captured during onboarding. Email is the
  // canonical channel for sending PO copies; address is printed on
  // PO PDFs.
  email        String?
  address      String?
  rating       Float           @default(0)
  leadTimeDays Int             @default(7)
  city         String
  // Default payment terms label printed on POs (e.g. "Net 30",
  // "Advance 50%"). Free-text by design - operators may have very
  // contract-specific phrasing.
  paymentTerms String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  pos          PurchaseOrder[]
  catalog      VendorProduct[]
  stockRules   StockRule[]
}

// Odoo-style supplierinfo: vendor-specific product code, name, UoM,
// price, and conversion into our internal product UoM.
model VendorProduct {
  id                String          @id @default(cuid())
  vendorId          String
  productId         String
  variantId         String?
  // Vendor's own SKU / item code on their price list.
  vendorProductCode String?
  // Vendor's product name (may differ from our catalog name).
  vendorProductName String?
  // Unit the vendor quotes and ships in (e.g. "bag", "drum", "MT").
  vendorUom         String
  // How many internal product.uom units one vendorUom represents.
  // Example: product uom=kg, vendor sells 50 kg bags → packSize=50.
  packSize          Float           @default(1)
  // Price per 1 vendorUom (not per internal uom).
  price             Float           @default(0)
  minOrderQty       Float           @default(1)
  // Override vendor.leadTimeDays when set.
  leadTimeDays      Int?
  // Lower = preferred when multiple vendors supply the same product.
  priority          Int             @default(100)
  active            Boolean         @default(true)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  vendor            Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  poItems           PurchaseOrderItem[]

  @@unique([vendorId, productId, variantId])
  @@index([vendorId])
  @@index([productId])
  @@index([variantId])
}

model Customer {
  id              String            @id @default(cuid())
  code            String            @unique
  name            String
  gst             String?
  // Structured ship-to / billing address (Indian postal format).
  addressLine     String?
  city            String?
  district        String?
  state           String?
  pincode         String?
  // Approx. km from company dispatch pincode — computed when address is saved.
  distanceKm      Float?
  dispatchPincode String?
  contact         String?
  // Total credit we extend to this customer. Outstanding (unpaid) invoice
  // balance is computed at runtime and compared against this when accepting
  // quotes. 0 = no credit allowed (cash-only).
  creditLimit     Float             @default(0)
  // Which price tier this customer is on (Retail, Dealer, Distributor ...).
  // null => fall through to product default selling price.
  priceListId     String?
  priceList       PriceList?        @relation(fields: [priceListId], references: [id])
  // Optional invoice numbering scheme override (null → channel default).
  documentSeriesId String?
  documentSeries   DocumentSeries?  @relation(fields: [documentSeriesId], references: [id])
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  invoices        Invoice[]
  quotes          Quote[]
  salesOrders     SalesOrder[]
  account         CustomerAccount?
  addresses       CustomerAddress[]
  payments        CustomerPayment[]
  customerReturns CustomerReturn[]
  creditNotes     CreditNote[]
  enquiries       Enquiry[]

  @@index([priceListId])
  @@index([documentSeriesId])
}

// ─── CRM: Enquiries / leads pipeline ──────────────────────────────────────
// An Enquiry is an inbound interest captured BEFORE a Customer/Quote exists.
// It can be a product enquiry, a dealership application, a farm-visit request,
// or anything else. It moves through a pipeline (new → contacted → qualified
// → proposal → won/lost) and, when won, is linked to (or creates) a Customer.
model Enquiry {
  id        String @id @default(cuid())
  enquiryNo String @unique
  type      String @default("product") // product | dealership | farm_visit | other
  stage     String @default("new") // new | contacted | qualified | proposal | won | lost
  source    String @default("walk_in") // walk_in | phone | website | whatsapp | referral | exhibition | social | other
  priority  String @default("medium") // low | medium | high

  // Lead contact — captured even when the lead is not yet a Customer.
  contactName String
  phone       String?
  email       String?
  company     String?
  city        String?

  subject           String
  requirement       String? // free-form description of the need
  estimatedValue    Float     @default(0) // pipeline value for forecasting
  expectedCloseDate DateTime?
  nextFollowUpAt    DateTime? // denormalised from the earliest open task for quick filtering

  // Pipeline outcome
  lostReason String?
  wonAt      DateTime?
  lostAt     DateTime?

  // Links
  customerId       String? // existing customer, or the one created on conversion
  customer         Customer? @relation(fields: [customerId], references: [id])
  assignedToId     String?
  assignedTo       User?     @relation("EnquiryAssignee", fields: [assignedToId], references: [id])
  createdById      String?
  createdBy        User?     @relation("EnquiryCreator", fields: [createdById], references: [id])
  convertedQuoteId String? // optional deep-link if a quote is later raised

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      EnquiryItem[]
  activities EnquiryActivity[]

  @@index([stage])
  @@index([type])
  @@index([assignedToId])
  @@index([customerId])
  @@index([nextFollowUpAt])
}

// Optional line items for product / dealership enquiries. Either references a
// catalog Product/Variant, or carries a free-text description for something
// not yet in the catalog.
model EnquiryItem {
  id          String          @id @default(cuid())
  enquiryId   String
  productId   String?
  variantId   String?
  description String? // free text when product not in catalog
  qty         Float           @default(1)
  notes       String?
  enquiry     Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([enquiryId])
}

// Timeline entry on an enquiry. Doubles as a follow-up task when dueAt is set
// (open task = dueAt set & completedAt null).
model EnquiryActivity {
  id          String    @id @default(cuid())
  enquiryId   String
  type        String // note | call | email | meeting | whatsapp | visit | stage_change
  body        String
  outcome     String?
  dueAt       DateTime?
  completedAt DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  enquiry     Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([dueAt])
}

// Accounts-Receivable payment recorded against a customer.
// A single payment can be allocated across multiple invoices
// (CustomerPaymentAllocation). Auto-allocation is oldest-first.
model CustomerPayment {
  id          String                      @id @default(cuid())
  paymentNo   String                      @unique
  customerId  String
  amount      Float // total amount of this payment
  mode        String // cash | upi | bank_transfer | cheque | credit_note | razorpay
  reference   String? // cheque no / UTR / bank ref number
  gateway          String? // razorpay | ccavenue | null (manual)
  gatewayPaymentId String? // rzp pay_XXX
  gatewayOrderId   String? // rzp order_XXX
  notes       String?
  paymentDate DateTime                    @default(now())
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  customer    Customer                    @relation(fields: [customerId], references: [id])
  allocations CustomerPaymentAllocation[]

  @@index([customerId])
  @@index([paymentDate])
}

// Splits a CustomerPayment across individual invoices.
// amount here is how much of the parent payment is applied to this invoice.
model CustomerPaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Float
  createdAt DateTime        @default(now())
  payment   CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice         @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// CustomerAccount holds the self-service identity for storefront
// customers. Kept as a separate row from Customer so the existing
// Customer table - which is also used for B2B walk-in customers
// without any portal login - stays unchanged. passwordHash is nullable
// because the current mock storefront does not require login; a
// future signup flow will populate it.
model CustomerAccount {
  id              String    @id @default(cuid())
  customerId      String    @unique
  email           String?
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  passwordHash    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phone])
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  label       String?
  name        String
  phone       String
  addressLine String
  city        String
  district    String?
  state           String?
  pincode     String
  distanceKm      Float?
  dispatchPincode String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model OtpToken {
  id         String    @id @default(cuid())
  phone      String
  purpose    String // login | track
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, expiresAt])
}

model SmsProviderConfig {
  id           String   @id @default("default")
  provider     String   @default("smsidea")
  mode         String   @default("test") // test | live
  username     String?
  password     String?
  senderId     String?
  templateId   String? // DLT template id for OTP
  templateText String? // DLT OTP template body (must match registration)
  orderTemplateId   String?
  orderTemplateText String?
  peid         String? // DLT Principal Entity ID
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ShiprocketConfig {
  id            String   @id @default("default")
  email         String?
  password      String?
  pickupPincode String?
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DevOtpLog {
  id        String   @id @default(cuid())
  phone     String
  purpose   String
  code      String
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// Razorpay / gateway checkout session before SO is created.
model PaymentIntent {
  id               String   @id @default(cuid())
  gateway          String // razorpay | payu
  gatewayOrderId   String   @unique
  amount           Float
  currency         String   @default("INR")
  status           String   @default("created") // created | paid | failed | abandoned
  email            String?
  phone            String?
  cartSnapshot     String // JSON: items, ship-to, totals
  salesOrderId     String?
  gatewayPaymentId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([status])
}

// Admin-configured payment gateway credentials (Razorpay, future CCAvenue).
model PaymentGatewayConfig {
  id            String   @id @default(cuid())
  gateway       String   @unique // razorpay | ccavenue | payu
  mode          String   @default("test") // test | live
  keyId         String?
  keySecret     String?
  webhookSecret String?
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// =====================================================================
// Dynamic Pricing
// =====================================================================
//
// Each customer is assigned to one PriceList (Retail, Dealer, etc).
// Resolution waterfall for the effective price of a line item:
//   1. PriceListItem override for (priceList, product, variant) where
//      minQty <= line qty (highest matching minQty wins -> quantity-break tiers)
//   2. List-wide formula: basis * multiplier where basis ∈ {selling, cost}
//      e.g. Dealer = sellingPrice * 0.85 (15% off MRP)
//   3. ProductVariant.sellingPriceOverride ?? Product.sellingPrice (fallback)

model PriceList {
  id          String          @id @default(cuid())
  code        String          @unique // RETAIL, DEALER, DISTRIBUTOR
  name        String
  description String?
  currency    String          @default("INR")
  // When a SKU has no explicit override in this list, derive price as
  // basis * multiplier. basis is the field on Product to use.
  basis       String          @default("selling") // "selling" | "cost"
  multiplier  Float           @default(1.0)
  active      Boolean         @default(true)
  isDefault   Boolean         @default(false)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       PriceListItem[]
  customers   Customer[]
}

model PriceListItem {
  id          String          @id @default(cuid())
  priceListId String
  productId   String
  variantId   String?
  // Absolute price for this SKU in this list at >= minQty units.
  price       Float
  // Quantity tier (slab) start. minQty=1 => applies to any qty.
  // Multiple rows with different minQty values create a quantity-break ladder.
  minQty      Float           @default(1)
  notes       String?
  // Scheduled price revisions: null means "no bound" (always applies).
  // Multiple rows for the same (priceList, product, variant, minQty) can
  // exist with different windows — the resolver picks the one whose window
  // covers "now" and was most recently effective (newest validFrom).
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  priceList   PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  // No longer unique: revisions intentionally stack for the same SKU/tier.
  @@index([priceListId, productId, variantId, minQty])
  @@index([priceListId])
  @@index([productId])
}

// =====================================================================
// Procurement
// =====================================================================

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNo         String              @unique
  vendorId     String
  date         DateTime
  expectedDate DateTime
  status       String              @default("draft") // draft | approved | partial | received | closed | cancelled
  amount       Float               @default(0)
  receivedPct  Int                 @default(0)
  notes        String?
  // Opaque token used to mint the customer-facing share URL
  // (/share/purchase-order/<token>). Lazy-minted on first share - we
  // don't backfill existing rows. Rotating regenerates a new token,
  // which makes the previous link 404. Indexed so the public lookup
  // is O(1).
  shareToken   String?             @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  items        PurchaseOrderItem[]
  grns         Grn[]

  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  poId            String
  productId       String
  qty             Float
  rate            Float
  amount          Float
  received        Float          @default(0)
  // Link to vendor catalog line + snapshot of vendor-side ordering terms.
  vendorProductId String?
  vendorQty       Float?
  vendorUom       String?
  vendorRate      Float?
  po              PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])
  vendorProduct   VendorProduct? @relation(fields: [vendorProductId], references: [id], onDelete: SetNull)
  grnItems        GrnItem[]

  @@index([poId])
  @@index([productId])
  @@index([vendorProductId])
}

model Grn {
  id         String        @id @default(cuid())
  grnNo      String        @unique
  poId       String
  date       DateTime      @default(now())
  qcStatus   String        @default("pending") // pending | pass | rework | reject
  // Optional shipping/transport metadata captured at the gate so the
  // GRN queue can show "truck MH-12-2210" without hand-typing it on
  // every receipt screen.
  truckNo    String?
  driver     String?
  notes      String?
  // Free-text receiver name (operator who recorded the receipt). Kept
  // separate from the audit log so the row can be displayed in lists
  // without joining AuditLog.
  receivedBy String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  po         PurchaseOrder @relation(fields: [poId], references: [id])
  items      GrnItem[]

  @@index([poId])
  @@index([qcStatus])
}

model GrnItem {
  id          String            @id @default(cuid())
  grnId       String
  // PO line this receipt is filling. Each PO line can be filled by
  // multiple GRNs (partial receipts) - the running total on
  // PurchaseOrderItem.received is recomputed on every GRN write.
  poItemId    String
  receivedQty Float
  // Optional rejection per line. When > 0 these units don't enter
  // stock and don't count toward PO.received - they're flagged for
  // return-to-vendor on the GRN report.
  rejectedQty Float             @default(0)
  remarks     String?
  // Supplier / internal lot captured at receipt. When omitted the
  // server mints `{grnNo}-L{seq}` for raw or batch-tracked products.
  batchNo     String?
  expiryDate  DateTime?
  grn         Grn               @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem      PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  stockLots   StockLot[]

  @@index([grnId])
  @@index([poItemId])
}

// Traceable inventory lot. One GRN line typically creates one lot;
// MO issue consumes lots in FIFO order (receivedAt ascending).
model StockLot {
  id          String    @id @default(cuid())
  productId   String
  variantId   String?
  batchNo     String
  // grn | production | adjustment
  sourceType  String
  sourceRef   String
  receivedAt  DateTime  @default(now())
  expiryDate  DateTime?
  qtyOnHand   Int       @default(0)
  warehouseId String
  binId       String?
  grnItemId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  bin         Bin?            @relation(fields: [binId], references: [id])
  grnItem     GrnItem?        @relation(fields: [grnItemId], references: [id])
  ledger      StockLedger[]

  @@index([grnItemId])
  @@index([productId, receivedAt])
  @@index([productId, qtyOnHand])
  @@index([warehouseId])
  @@index([binId])
  @@index([batchNo])
}

// =====================================================================
// Manufacturing
// =====================================================================

model Bom {
  id                  String              @id @default(cuid())
  productId           String
  // Variant-level BOMs: when set, this BOM applies to one specific
  // variant of `product` (e.g. "Coconut oil 5L" vs "Coconut oil 1L"
  // which need different bottles, caps, cartons). When null, the BOM
  // is treated as the product-level default and is used for any
  // variant that has no variant-specific BOM.
  variantId           String?
  revision            String              @default("Rev-1.0")
  outputQty           Float               @default(1)
  active              Boolean             @default(true)
  // DEPRECATED: was FK to WorkCenter (now ProductionFacility). Use defaultFacilityId.
  // Kept nullable here so existing rows survive the migration and the backfill
  // script can read it to populate defaultFacilityId. Drop in a follow-up migration.
  defaultWorkCenterId String?
  // New two-level defaults: facility (required for MO creation) + specific line
  // (optional preference that the supervisor can override at MO assign time).
  defaultFacilityId   String?
  defaultLineId       String?
  defaultMachineId    String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  product             Product             @relation(fields: [productId], references: [id])
  variant             ProductVariant?     @relation(fields: [variantId], references: [id])
  // Legacy relation kept for backfill reads; do not use in new code.
  defaultWorkCenter   ProductionFacility? @relation("BomLegacyWorkCenter", fields: [defaultWorkCenterId], references: [id])
  defaultFacility     ProductionFacility? @relation("BomDefaultFacility", fields: [defaultFacilityId], references: [id])
  defaultLine         ProductionLine?     @relation("BomDefaultLine", fields: [defaultLineId], references: [id])
  defaultMachine      Machine?            @relation(fields: [defaultMachineId], references: [id])
  items               BomItem[]
  byproducts          BomByproduct[]
  operations          BomOperation[]
  productionOrders    ProductionOrder[]
  stockRules          StockRule[]
  // Odoo BoM Miscellaneous → Operation Dependencies
  operationDependencies Boolean           @default(false)

  @@index([productId])
  @@index([variantId])
  @@index([defaultWorkCenterId])
  @@index([defaultFacilityId])
  @@index([defaultLineId])
  @@index([defaultMachineId])
}

model BomItem {
  id             String        @id @default(cuid())
  bomId          String
  // Odoo mrp.bom.line.operation_id — consume at this routing step.
  bomOperationId String?
  productId      String
  qty            Float
  uom            String
  scrapPct       Float         @default(0)
  bom            Bom           @relation(fields: [bomId], references: [id], onDelete: Cascade)
  bomOperation   BomOperation? @relation(fields: [bomOperationId], references: [id], onDelete: SetNull)
  product        Product       @relation(fields: [productId], references: [id])

  @@index([bomId])
  @@index([bomOperationId])
}

// Odoo mrp.bom.operation — one row per manufacturing step on the BOM.
model BomOperation {
  id                   String              @id @default(cuid())
  bomId                String
  seq                  Int
  name                 String
  description          String?
  // Default work center (Odoo Work Center → facility + line + machine).
  facilityId           String?
  lineId               String?
  machineId            String?
  durationMinutes      Float?
  requiresQa           Boolean             @default(true)
  // Odoo Blocked By — predecessor operation on the same BOM.
  blockedByOperationId String?
  bom                  Bom                 @relation(fields: [bomId], references: [id], onDelete: Cascade)
  facility             ProductionFacility? @relation(fields: [facilityId], references: [id])
  line                 ProductionLine?     @relation("BomOperationLine", fields: [lineId], references: [id])
  machine              Machine?            @relation("BomOperationMachine", fields: [machineId], references: [id])
  blockedBy            BomOperation?       @relation("OperationDependency", fields: [blockedByOperationId], references: [id], onDelete: SetNull)
  blocking             BomOperation[]      @relation("OperationDependency")
  items                BomItem[]
  eligibleLines        BomOperationLine[]
  workOrders           WorkOrder[]

  @@unique([bomId, seq])
  @@index([bomId])
  @@index([blockedByOperationId])
}

// Lines allowed to run an operation (parallel extraction on EXT-01 + EXT-03).
model BomOperationLine {
  id             String       @id @default(cuid())
  bomOperationId String
  lineId         String
  bomOperation   BomOperation @relation(fields: [bomOperationId], references: [id], onDelete: Cascade)
  line           ProductionLine @relation(fields: [lineId], references: [id])

  @@unique([bomOperationId, lineId])
  @@index([lineId])
}

// Secondary outputs produced alongside the main finished good when an
// MO completes (by-products / co-products). Not consumed at issue.
model BomByproduct {
  id        String          @id @default(cuid())
  bomId     String
  productId String
  variantId String?
  qty       Float
  uom       String
  costShare Float           @default(0)
  bom       Bom             @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  runYields WorkOrderRunByproduct[]

  @@index([bomId])
  @@index([productId])
}

model ProductionOrder {
  id             String              @id @default(cuid())
  orderNo        String              @unique
  bomId          String
  // DEPRECATED text field; use facilityId FK for new code. Populated from
  // facility.name on MO create so legacy reports still render. Drop in follow-up.
  station        String
  // New facility + line FKs. facilityId is required for all new MOs; lineId is
  // null until a supervisor assigns the MO to a specific production line.
  facilityId     String?
  lineId         String?
  plannedQty     Float
  actualQty      Float               @default(0)
  scrapQty       Float               @default(0)
  reworkQty      Float               @default(0)
  status         String              @default("planned") // planned | in-progress | qc | completed | delayed
  startDate      DateTime
  dueDate        DateTime
  efficiency     Float               @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  bom            Bom                 @relation(fields: [bomId], references: [id])
  facility       ProductionFacility? @relation(fields: [facilityId], references: [id])
  line           ProductionLine?     @relation("MoLine", fields: [lineId], references: [id])
  workOrders     WorkOrder[]
  transferOrders TransferOrder[]

  @@index([status])
  @@index([bomId])
  @@index([facilityId])
  @@index([lineId])
}

model WorkOrder {
  id                String          @id @default(cuid())
  workOrderNo       String          @unique
  productionOrderId String
  // DEPRECATED text fields; use lineId / machineId for new code. Drop in follow-up.
  station           String
  machine           String
  workers           String // CSV
  output            Float           @default(0)
  target            Float
  startTime         DateTime?
  endTime           DateTime?
  status            String          @default("queued") // waiting | ready | queued | running | paused | complete | rework
  // Odoo mrp.workorder ↔ mrp.bom.operation
  bomOperationId    String?
  splitSeq          Int             @default(0)
  plannedSplitQty   Float?
  // Odoo Blocked By (work order level)
  blockedByWorkOrderId String?
  qaStatus          String?         // pending | pass | fail
  qaNotes           String?
  // Set by supervisor when assigning the parent MO to a specific line/machine.
  lineId            String?
  machineId         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  bomOperation      BomOperation?   @relation(fields: [bomOperationId], references: [id], onDelete: SetNull)
  blockedByWorkOrder WorkOrder?     @relation("WoDependency", fields: [blockedByWorkOrderId], references: [id], onDelete: SetNull)
  blockingWorkOrders WorkOrder[]    @relation("WoDependency")
  line              ProductionLine? @relation("WoLine", fields: [lineId], references: [id])
  machineRef        Machine?        @relation("WoMachine", fields: [machineId], references: [id])
  runs              WorkOrderRun[]

  @@index([productionOrderId])
  @@index([status])
  @@index([lineId])
  @@index([bomOperationId])
  @@index([blockedByWorkOrderId])
}

// One physical machine "run" inside a WorkOrder. A WO without runs
// keeps the legacy single-machine behavior (output is the scalar on
// WorkOrder). When ≥1 run exists, the WO output is rolled up from
// sum(runs.goodQty) and the WO can be done in parallel across many
// machines (e.g. unrefined oil extraction across two screw presses).
// Each run captures the partial input consumed at that machine and
// the partial good/scrap qty it produced, plus the time window.
model WorkOrderRun {
  id           String    @id @default(cuid())
  workOrderId  String
  machineId    String
  lineId       String?
  // Sequential batch number within this work order (batch 1, 2, 3…).
  batchSeq     Int       @default(1)
  // Planner-set qty allocated to this machine (optional — used to show
  // a per-run progress bar; rollup uses goodQty regardless).
  plannedQty   Float?
  // Actuals.
  inputQty     Float     @default(0)
  goodQty      Float     @default(0)
  scrapQty     Float     @default(0)
  status       String    @default("queued") // queued | running | complete | abandoned
  startTime    DateTime?
  endTime      DateTime?
  operator     String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  machine      Machine   @relation(fields: [machineId], references: [id])
  line         ProductionLine? @relation(fields: [lineId], references: [id])
  byproducts   WorkOrderRunByproduct[]

  @@index([workOrderId])
  @@index([machineId])
  @@index([status])
}

// By-product yields tied to a specific machine run (batch). Posted to
// inventory when the run is completed, same as MO log-output byproducts.
model WorkOrderRunByproduct {
  id             String       @id @default(cuid())
  workOrderRunId String
  bomByproductId String
  qty            Float
  posted         Boolean      @default(false)
  workOrderRun   WorkOrderRun @relation(fields: [workOrderRunId], references: [id], onDelete: Cascade)
  bomByproduct   BomByproduct @relation(fields: [bomByproductId], references: [id])

  @@unique([workOrderRunId, bomByproductId])
  @@index([workOrderRunId])
}

// =====================================================================
// Production master data
// =====================================================================
//
// ProductionFacility = a physical production area / department
// (e.g. "Soap Room", "Snacks Room"). A facility owns one optional
// dedicated production-line warehouse for material staging and FG
// holding. Multiple ProductionLines run inside a single facility.
//
// ProductionLine = a specific line within a facility where work
// physically happens (e.g. "Boiling Line", "Mixing Line"). A line
// owns its machines. The supervisor assigns an MO to a line after
// the planner creates the MO against a facility.
//
// Machine = a physical asset on a production line
// (e.g. "Boiler #1", "Pouch sealer #2"). Status tracks availability.
//
// Legacy note: ProductionFacility maps to the legacy "WorkCenter"
// table (@@map) so no data copy is needed. Legacy free-text station /
// machine columns on Bom / ProductionOrder / WorkOrder are kept until
// a follow-up migration drops them.

model ProductionFacility {
  id                        String            @id @default(cuid())
  code                      String            @unique // e.g. "FAC-SOAP"
  name                      String // e.g. "Soap Room"
  description               String?
  // Optional throughput hint (produced units / hour) for load-balancing.
  capacityPerHour           Float?
  // One shared production-line warehouse per facility. MO release creates
  // replenishment TOs into this WH; MO complete lands FG here before putaway.
  // For in-situ lines (e.g. vacuum packing in Stock Room zone A) this may
  // point at the same storage warehouse as putaway — no separate prod WH.
  productionLineWarehouseId String?           @unique
  // When set, MO complete / receive auto-pick prefers bins in this zone
  // within the production-line warehouse (e.g. "A" in STR).
  productionZone            String?
  // Comma-separated warehouse codes to pull replenishment from on MO
  // release (e.g. WH-GDNW,WH-STOR,WH-PROD-OIL). Falls back to [ops]
  // replenish= tag in description when null.
  replenishWarehouseCodes   String?
  active                    Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  lines                     ProductionLine[]
  // Legacy back-relations — do not use in new code.
  legacyBoms                Bom[]             @relation("BomLegacyWorkCenter")
  legacyMachines            Machine[]         @relation("MachineLegacyWorkCenter")
  // New back-relations.
  defaultedByBoms           Bom[]             @relation("BomDefaultFacility")
  bomOperations             BomOperation[]
  productionOrders          ProductionOrder[]
  productionLineWarehouse   Warehouse?        @relation("FacilityProductionWarehouse", fields: [productionLineWarehouseId], references: [id])

  @@index([active])
  @@map("WorkCenter")
}

model ProductionLine {
  id               String             @id @default(cuid())
  code             String             @unique // e.g. "LINE-SOAP-BOIL"
  name             String // e.g. "Boiling Line"
  description      String?
  facilityId       String
  capacityPerHour  Float?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  facility         ProductionFacility @relation(fields: [facilityId], references: [id])
  machines         Machine[]
  defaultedByBoms  Bom[]              @relation("BomDefaultLine")
  bomOperations    BomOperation[]     @relation("BomOperationLine")
  operationEligibility BomOperationLine[]
  productionOrders ProductionOrder[]  @relation("MoLine")
  workOrders       WorkOrder[]        @relation("WoLine")
  workOrderRuns    WorkOrderRun[]

  @@index([facilityId])
  @@index([active])
}

model Machine {
  id               String              @id @default(cuid())
  code             String              @unique // e.g. "PCH-SEAL-02"
  name             String
  // DEPRECATED: was FK to WorkCenter (now ProductionFacility). Use productionLineId.
  // Kept nullable here so the backfill script can read it before it is populated.
  // Drop in a follow-up migration once productionLineId is fully backfilled.
  workCenterId     String?
  // New FK: which production line this machine physically belongs to.
  productionLineId String?
  // Operational status. Idle = available but not currently running.
  // Maintenance = scheduled downtime. Broken = unscheduled outage.
  status           String              @default("idle") // running | idle | maintenance | broken
  description      String?
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  // Legacy relation — do not use in new code.
  workCenter       ProductionFacility? @relation("MachineLegacyWorkCenter", fields: [workCenterId], references: [id])
  productionLine   ProductionLine?     @relation(fields: [productionLineId], references: [id])
  defaultedByBoms  Bom[]
  bomOperations    BomOperation[]     @relation("BomOperationMachine")
  workOrders       WorkOrder[]         @relation("WoMachine")
  workOrderRuns    WorkOrderRun[]

  @@index([workCenterId])
  @@index([productionLineId])
  @@index([active])
}

// =====================================================================
// Workforce
// =====================================================================

model Worker {
  id            String       @id @default(cuid())
  empNo         String       @unique
  name          String
  station       String
  shift         String       @default("A")
  status        String       @default("out") // in | out | break
  unitsToday    Float        @default(0)
  targetToday   Float        @default(0)
  efficiency    Float        @default(0)
  rejectionRate Float        @default(0)
  hoursToday    Float        @default(0)
  active        Boolean      @default(true)
  // Optional one-to-one link to the User who logs into the mobile PWA.
  // When set, mobile punch-in/out goes through this Worker row; floor
  // identity == login identity. Nullable so legacy floor-only workers
  // keep working without a login.
  userId        String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User?        @relation("WorkerUser", fields: [userId], references: [id])
  attendance    Attendance[]
}

model Attendance {
  id       String    @id @default(cuid())
  workerId String
  date     DateTime
  inAt     DateTime?
  outAt    DateTime?
  shift    String
  hours    Float     @default(0)
  worker   Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, date])
}

// =====================================================================
// Putaway rules + internal transfer orders
// =====================================================================

// Declares "when a finished product X (optionally variant Y) is received
// at the production line, move it to this storage warehouse / bin".
// Resolution waterfall used by resolvePutawayDestination():
//   variant rule (lowest priority number) > product rule > system fallback.
model PutawayRule {
  id            String          @id @default(cuid())
  productId     String
  variantId     String?
  toWarehouseId String
  // Optional preferred zone within toWarehouse. When set (and toBinId
  // is null), MO complete / putaway resolution will land stock in a
  // zone-level slot for the product (one bin per product inside the
  // zone, displayed as `<warehouse> → Zone <z> → <SKU>`). Useful when
  // you want all finished goods staged in one staging zone (e.g.
  // STR.PR for vacuum-pack staging) without pinning a fixed bin.
  toZone        String?
  // Optional preferred bin within toWarehouse. When null the system
  // auto-picks the best available bin via pickBinForReceive(), or a
  // zone slot when toZone is set.
  toBinId       String?
  // Lower = higher priority when multiple rules match.
  priority      Int             @default(100)
  active        Boolean         @default(true)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  toWarehouse   Warehouse       @relation("PutawayRuleTo", fields: [toWarehouseId], references: [id])
  tobin         Bin?            @relation(fields: [toBinId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([toWarehouseId])
}

// Monitors a bin's qty (or company-wide total when monitorBinId is null);
// when below minQty, auto-creates an MO, transfer, or draft PO.
model StockRule {
  id            String          @id @default(cuid())
  productId     String
  variantId     String?
  // Null = monitor total qty across all bins (used with triggerType=po).
  monitorBinId  String?
  minQty        Float
  // Target stock level to order up to (po triggers). Defaults to 2× minQty.
  maxQty        Float?
  // Round vendor order qty up to this multiple (po triggers).
  orderMultiple Float?
  // mo | transfer | po
  triggerType   String
  // Required for po triggers — lines group into one draft PO per vendor.
  vendorId      String?
  bomId         String?
  sourceBinId   String?
  toWarehouseId String?
  toBinId       String?
  tags          String?
  active        Boolean         @default(true)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  monitorBin    Bin?            @relation("StockRuleMonitor", fields: [monitorBinId], references: [id])
  bom           Bom?            @relation(fields: [bomId], references: [id])
  sourceBin     Bin?            @relation("StockRuleSource", fields: [sourceBinId], references: [id])
  toBin         Bin?            @relation("StockRuleDest", fields: [toBinId], references: [id])
  toWarehouse   Warehouse?      @relation("StockRuleToWarehouse", fields: [toWarehouseId], references: [id])
  vendor        Vendor?         @relation(fields: [vendorId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([monitorBinId])
  @@index([active])
  @@index([triggerType])
  @@index([vendorId])
}

// A first-class internal movement document. Three kinds:
//   putaway      - FG leaving production line -> storage (auto-created on MO complete)
//   replenishment - raw materials leaving storage -> production line (auto-created on MO release)
//   manual       - operator-initiated movement between any two warehouses
//
// Status flow: draft -> ready -> in_transit -> done
//              any -> cancelled
model TransferOrder {
  id                String              @id @default(cuid())
  transferNo        String              @unique // TRF-2026-NNNN
  kind              String // putaway | replenishment | manual
  status            String              @default("ready") // draft | ready | in_transit | done | cancelled
  fromWarehouseId   String
  toWarehouseId     String
  // Back-link to the MO that triggered this TO (null for manual).
  productionOrderId String?
  // Who is handling this TO on the mobile.
  assignedToId      String?
  claimedAt         DateTime?
  // Timestamps for pick (items leave source bins) and drop (items enter destination bins).
  pickedById        String?
  pickedAt          DateTime?
  droppedById       String?
  droppedAt         DateTime?
  cancelledAt       DateTime?
  notes             String?
  // Comma-separated team/routing tags for mobile task filtering.
  tags              String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  fromWarehouse     Warehouse           @relation("TransferOrderFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse       Warehouse           @relation("TransferOrderToWarehouse", fields: [toWarehouseId], references: [id])
  productionOrder   ProductionOrder?    @relation(fields: [productionOrderId], references: [id])
  assignedTo        User?               @relation("TransferOrderAssignee", fields: [assignedToId], references: [id])
  pickedBy          User?               @relation("TransferOrderPicker", fields: [pickedById], references: [id])
  droppedBy         User?               @relation("TransferOrderDropper", fields: [droppedById], references: [id])
  items             TransferOrderItem[]

  @@index([status])
  @@index([kind])
  @@index([productionOrderId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([assignedToId])
}

model TransferOrderItem {
  id              String          @id @default(cuid())
  transferOrderId String
  productId       String
  variantId       String?
  // System-computed required quantity.
  qtyRequested    Float
  // Filled in at pick time (may be <= qtyRequested if short).
  qtyPicked       Float           @default(0)
  // Filled in at drop time (may differ from qtyPicked on variance).
  qtyDropped      Float           @default(0)
  // Source bin (system-suggested; operator may override at pick time).
  fromBinId       String?
  // Destination bin resolved from PutawayRule or operator scan at drop time.
  toBinId         String?
  notes           String?
  transferOrder   TransferOrder   @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  fromBin         Bin?            @relation("TransferItemFromBin", fields: [fromBinId], references: [id])
  tobin           Bin?            @relation("TransferItemToBin", fields: [toBinId], references: [id])

  @@index([transferOrderId])
  @@index([productId])
}

// =====================================================================
// Inventory
// =====================================================================

model StockLedger {
  id          String          @id @default(cuid())
  date        DateTime        @default(now())
  productId   String
  // Optional pointer to the specific variant this row moved. Populated
  // by variant-scoped flows (e.g. producing the 250ml CAOL variant via
  // a variant-scoped BOM, or transferring a tagged variant SKU). NULL
  // means the row applies to the parent product / bulk stock.
  variantId   String?
  txnType     String // GRN | Issue | Transfer | Sale | Production | Adjust
  ref         String
  qty         Float
  warehouseId String
  bin         String?
  // Lot / batch consumed or received on this movement (denormalized
  // from StockLot.batchNo for fast ledger reads).
  batch       String?
  lotId       String?
  balance     Float           @default(0)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  lot         StockLot?       @relation(fields: [lotId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([txnType])
  @@index([date])
  @@index([lotId])
  @@index([batch])
}

// =====================================================================
// Billing & Dispatch
// =====================================================================

model Invoice {
  id                 String                      @id @default(cuid())
  invoiceNo          String                      @unique
  // Random opaque token that lets the customer view this invoice without
  // logging in. Minted on creation and exposed via /v1/public/invoices/:token.
  // Can be rotated to revoke the share link.
  shareToken         String?                     @unique
  customerId         String
  // Optional link back to the originating Sales Order. Walk-in (POS)
  // invoices have null. One SO can be drawn down by many invoices.
  salesOrderId       String?
  // When the invoice was generated from a PackingSlip (the recommended
  // B2B flow) we keep that link so qty traceability is end-to-end.
  packingSlipId      String?                     @unique
  date               DateTime                    @default(now())
  amount             Float
  tax                Float
  cgstTotal          Float                       @default(0)
  sgstTotal          Float                       @default(0)
  igstTotal          Float                       @default(0)
  taxKind            String                      @default("intra") // intra | inter
  placeOfSupplyState String?
  sellerState        String?
  pricingInclusive   Boolean                     @default(false)
  transportCharge    Float                       @default(0)
  transportTax       Float                       @default(0)
  roundOff           Float                       @default(0)
  // Estimated shipping weight in kg. For invoices generated from a
  // PackingSlip we copy the cached slip total (which folds in actual
  // scale readings when present); for direct/walk-in invoices we
  // derive it from the line items.
  totalWeightKg      Float                       @default(0)
  status             String                      @default("draft") // draft | issued | paid | partial | overdue
  paymentMode        String // cash | card | upi | credit | split
  dispatchOptionId   String?
  notes              String?
  // Numbering scheme used when this invoice was minted (audit trail).
  documentSeriesId   String?
  seriesSeq          Int?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  customer           Customer                    @relation(fields: [customerId], references: [id])
  salesOrder         SalesOrder?                 @relation(fields: [salesOrderId], references: [id])
  packingSlip        PackingSlip?                @relation(fields: [packingSlipId], references: [id])
  dispatchOption     DispatchOption?             @relation(fields: [dispatchOptionId], references: [id])
  documentSeries     DocumentSeries?             @relation(fields: [documentSeriesId], references: [id])
  items              InvoiceItem[]
  paymentAllocations CustomerPaymentAllocation[]
  dispatches         DispatchOrder[]
  customerReturns    CustomerReturn[]
  creditNotes        CreditNote[]

  @@index([status])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([dispatchOptionId])
  @@index([documentSeriesId])
}

model InvoiceItem {
  id                String           @id @default(cuid())
  invoiceId         String
  productId         String
  variantId         String?
  // Draws down a specific Sales Order line when invoice is from an SO.
  salesOrderItemId  String?
  // When the line was generated from a PackingSlip line, link it so we
  // can show ordered/picked/packed/invoiced trail per SKU.
  packingSlipItemId String?
  qty               Float
  rate              Float
  amount            Float
  taxableValue      Float?
  // Snapshot of the GST rate at time of invoicing so historical accuracy is
  // preserved even if the product rate is changed later.
  gstRate           Float?           @default(18)
  taxAmount         Float?
  cgstAmount        Float?
  sgstAmount        Float?
  igstAmount        Float?
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product           Product          @relation(fields: [productId], references: [id])
  variant           ProductVariant?  @relation(fields: [variantId], references: [id])
  salesOrderItem    SalesOrderItem?  @relation(fields: [salesOrderItemId], references: [id])
  packingSlipItem   PackingSlipItem? @relation(fields: [packingSlipItemId], references: [id])

  @@index([invoiceId])
  @@index([variantId])
  @@index([salesOrderItemId])
  @@index([packingSlipItemId])
}

model DispatchOrder {
  id          String    @id @default(cuid())
  dispatchNo  String    @unique
  invoiceId   String
  // Vehicle/driver are now optional - if the dispatch is on a Trip
  // (tripId set) it inherits these from the trip and the columns stay
  // null. They remain settable per-dispatch for legacy / one-off
  // direct dispatches that aren't on a planned trip.
  vehicle     String?
  driver      String?
  destination String?
  status      String    @default("planned") // planned | loading | in-transit | delivered | delayed
  etaHours    Int       @default(0)
  weightKg    Float     @default(0)
  otpVerified Boolean   @default(false)
  signedAt    DateTime?
  photoUrl    String?
  // Optional link to the Trip the operator has scheduled this drop on.
  // Null = unassigned (orphan); Trip cancellation moves dispatches to
  // a freshly-generated successor trip and never leaves them stranded.
  tripId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  trip        Trip?     @relation(fields: [tripId], references: [id])

  @@index([invoiceId])
  @@index([status])
  @@index([tripId])
}

// =====================================================================
// Logistics: Trip
// One vehicle + driver going out on a scheduled date with a roster of
// dispatch drops. Operators no longer fill vehicle/driver per invoice;
// they assign the dispatch to a trip instead. Trips can be created in
// advance for the next 3-4 days, rescheduled, or cancelled. On cancel
// the system spawns a successor trip and migrates all dispatches to
// it so no invoice is ever left without a transport plan.
// =====================================================================
model Trip {
  id               String          @id @default(cuid())
  tripNo           String          @unique
  scheduledDate    DateTime
  vehicle          String
  driver           String
  // Optional human label like "Bangalore South Loop" - shown on cards.
  route            String?
  // scheduled | in_transit | completed | cancelled
  status           String          @default("scheduled")
  // Soft capacity hint; used by the UI to show "82% full". Not enforced.
  capacityKg       Float           @default(1000)
  notes            String?
  createdById      String?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  // When this trip is the rollover successor of another trip, the
  // origin id is captured so the UI can show "rescheduled from TRP-...".
  rolledOverFromId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  dispatches       DispatchOrder[]

  @@index([scheduledDate])
  @@index([status])
}

// =====================================================================
// Sales: Quote -> Sales Order -> Invoice
// =====================================================================

// Admin-configurable dispatch / transport modes offered on quotes.
// Categories mirror common Indian B2B logistics channels:
//   door_to_door    — last-mile delivery to customer premises
//   bulk_carrier    — national LTL/FTL operators (Navata, VRL, etc.)
//   company_vehicle — own fleet (lorry, van, two-wheeler)
//   rtc_cargo       — state transport corporation parcel/cargo
//   bus_cargo       — private bus / tempo-traveller cargo space
//   railway         — Indian Railways parcel / freight
//   courier         — express parcel (Delhivery, BlueDart, DTDC)
//   customer_pickup — ex-works / customer-arranged transport
model DispatchOption {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  category      String
  description   String?
  // Suggested default freight (₹, excl. GST) — pre-fills the quote form.
  defaultCharge Float        @default(0)
  active        Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  quotes        Quote[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]

  @@index([category])
  @@index([active])
}

// =============================================================
// External sales-channel barcode / SKU mapping
// =============================================================
// When orders flow in from outside systems (DTDC shipping labels,
// Amazon, Flipkart, marketplace exports, …) their item codes do NOT
// match our internal SKUs. This table is the per-channel translation:
//   { channel: "DTDC", externalCode: "I100", internalSku: "ML401" }
//
// Maintained from Settings → Channel mappings (CSV upload + inline
// edits). Imported orders look up each PDF row by (channel, externalCode)
// to resolve to a Product/ProductVariant we actually stock.
//
// internalSku may match either ProductVariant.sku or (legacy) Product.sku;
// the import resolver tries variant first, then product.
model ChannelMapping {
  id           String   @id @default(cuid())
  channel      String   // e.g. "DTDC", "Amazon", "Flipkart"
  externalCode String   // courier/marketplace item code, e.g. "I100"
  internalSku  String   // our ProductVariant.sku (preferred) or Product.sku
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([channel, externalCode])
  @@index([internalSku])
  @@index([channel])
}

model Quote {
  id                    String          @id @default(cuid())
  quoteNo               String          @unique
  // Random opaque token that lets the customer view this quote without
  // logging in. Minted on creation and exposed via /v1/public/quotes/:token.
  // Can be rotated to revoke the share link.
  shareToken            String?         @unique
  // Current revision number. Submitted quotes get a new revision on every
  // edit; the prior state is snapshotted to QuoteRevision before the row
  // is mutated, so older revisions remain available for audit.
  revision              Int             @default(1)
  customerId            String
  status                String          @default("draft") // draft | submitted | accepted | rejected | expired | converted
  validUntil            DateTime
  subTotal              Float           @default(0)
  tax                   Float           @default(0)
  cgstTotal             Float           @default(0)
  sgstTotal             Float           @default(0)
  igstTotal             Float           @default(0)
  taxKind               String          @default("intra") // intra | inter
  placeOfSupplyState    String?
  sellerState           String?
  pricingInclusive      Boolean         @default(false)
  // Freight / transport charge (excl. GST). GST on freight is stored in
  // transportTax at 18% (SAC 9965 — goods transport agency services).
  transportCharge       Float           @default(0)
  transportTax          Float           @default(0)
  roundOff              Float           @default(0)
  total                 Float           @default(0)
  // Estimated shipping weight in kg: sum(item.qty * unitWeightKg(variant, product)).
  // Recomputed on every item mutation by recomputeQuoteWeight() so the
  // sales rep can quote freight up-front without waiting for the pack
  // stage. Carries forward into SalesOrder.totalWeightKg on conversion.
  totalWeightKg         Float           @default(0)
  // How goods will reach the customer — set from Settings → Dispatch options.
  dispatchOptionId      String?
  paymentTerms          String?
  notes                 String?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  // Set once the quote is converted into a Sales Order. Used to short-
  // circuit duplicate conversions and to deep-link in the UI.
  convertedSalesOrderId String?         @unique
  createdById           String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  customer              Customer        @relation(fields: [customerId], references: [id])
  dispatchOption        DispatchOption? @relation(fields: [dispatchOptionId], references: [id])
  items                 QuoteItem[]
  revisions             QuoteRevision[]
  salesOrder            SalesOrder?

  @@index([status])
  @@index([customerId])
  @@index([dispatchOptionId])
}

model QuoteItem {
  id         String          @id @default(cuid())
  quoteId    String
  productId  String
  variantId  String?
  qty        Float
  rate       Float
  discount   Float           @default(0) // percent (0-100)
  amount     Float
  taxableValue Float?
  gstRate    Float?
  cgstAmount Float?
  sgstAmount Float?
  igstAmount Float?
  requiredBy DateTime?
  quote      Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([quoteId])
}

model QuoteRevision {
  id        String   @id @default(cuid())
  quoteId   String
  revision  Int
  // Full JSON snapshot of the quote (header + items) at the moment this
  // revision was sealed. Immutable.
  snapshot  String
  reason    String // customer_request | stock_renegotiate | price_change | validity_extension | edit
  changedBy String
  changedAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, revision])
  @@index([quoteId])
}

model SalesOrder {
  id               String           @id @default(cuid())
  soNo             String           @unique
  // Random opaque token for read-only customer view via
  // /v1/public/sales-orders/:token. Useful as an order acknowledgement.
  shareToken       String?          @unique
  // Optional source quote (walk-in / direct SOs allowed).
  quoteId          String?          @unique
  customerId       String
  status           String           @default("confirmed") // confirmed | partially_invoiced | invoiced | closed | cancelled | on_hold
  // Where the order originated. "internal" = desktop/B2B (default),
  // "ecommerce" = prepaid storefront mock, "imported" = uploaded
  // shipping-label PDF from an external sales channel (DTDC, etc.).
  // Read by the pack-complete hook to decide whether to stamp a mock
  // AWB, by the invoice helper to pick the right number series, and
  // by reports that break down channel revenue.
  source           String           @default("internal")
  // External-channel identifiers, populated only when source="imported".
  // externalChannel = the channel name (e.g. "DTDC"), externalRef =
  // their order # (SO12627100436), externalAwb = waybill, and
  // externalInvoiceNo = the courier-printed invoice no for reference.
  externalChannel    String?
  externalRef        String?
  externalAwb        String?
  externalInvoiceNo  String?
  orderDate        DateTime         @default(now())
  subTotal         Float            @default(0)
  tax              Float            @default(0)
  cgstTotal        Float            @default(0)
  sgstTotal        Float            @default(0)
  igstTotal        Float            @default(0)
  taxKind          String           @default("intra") // intra | inter
  placeOfSupplyState String?
  sellerState      String?
  pricingInclusive Boolean          @default(false)
  transportCharge  Float            @default(0)
  transportTax     Float            @default(0)
  roundOff         Float            @default(0)
  total            Float            @default(0)
  // Estimated shipping weight in kg. Inherited from Quote.totalWeightKg
  // on confirmation and re-derived on any line edit. Trip planning uses
  // this for capacity hints before a packing slip exists.
  totalWeightKg    Float            @default(0)
  dispatchOptionId String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  customer         Customer         @relation(fields: [customerId], references: [id])
  quote            Quote?           @relation(fields: [quoteId], references: [id])
  dispatchOption   DispatchOption?  @relation(fields: [dispatchOptionId], references: [id])
  items            SalesOrderItem[]
  invoices         Invoice[]
  pickLists        PickList[]
  packingSlips     PackingSlip[]

  @@index([status])
  @@index([customerId])
  @@index([source])
  @@index([dispatchOptionId])
  @@index([externalRef])
}

model SalesOrderItem {
  id               String                  @id @default(cuid())
  salesOrderId     String
  productId        String
  variantId        String?
  qtyOrdered       Float
  qtyInvoiced      Float                   @default(0)
  qtyCancelled     Float                   @default(0)
  rate             Float
  amount           Float
  taxableValue     Float?
  gstRate          Float?
  cgstAmount       Float?
  sgstAmount       Float?
  igstAmount       Float?
  salesOrder       SalesOrder              @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product          Product                 @relation(fields: [productId], references: [id])
  variant          ProductVariant?         @relation(fields: [variantId], references: [id])
  invoiceItems     InvoiceItem[]
  pickListItems    PickListItem[]
  packingSlipItems PackingSlipItem[]
  reservations     SalesOrderReservation[]

  @@index([salesOrderId])
  @@index([productId])
  @@index([variantId])
}

// Hard reservation against a specific bin once an SO is confirmed.
// One row per (SO line, bin) split — a single line that can't fit in
// one bin produces multiple rows. Bin.reservedQty is the materialised
// total of these (plus pick-list reservations after pick→picked).
//
// Lifecycle:
//   * SO confirm / resume   → row(s) created, Bin.reservedQty += qty
//   * Invoice / pack-out    → row(s) trimmed proportionally
//   * Pick → picked         → SO reservation released, pick list
//                             reservation takes over (Bin.reservedQty
//                             stays put unless picker chose a different
//                             bin, in which case it transfers)
//   * SO cancel / hold      → row(s) deleted, Bin.reservedQty -= qty
model SalesOrderReservation {
  id               String         @id @default(cuid())
  salesOrderItemId String
  binId            String
  qty              Int
  createdAt        DateTime       @default(now())
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  bin              Bin            @relation(fields: [binId], references: [id], onDelete: Cascade)

  @@index([salesOrderItemId])
  @@index([binId])
}

// =====================================================================
// Fulfilment: Pick -> Pack -> Invoice
// =====================================================================
//
// A Sales Order is fulfilled by one or more PickLists. Each PickList is
// completed by the warehouse (qtyPicked recorded per line, with the
// physical bin recorded). Completing a PickList:
//   - increments Bin.reservedQty by qtyPicked (so the same physical
//     stock cannot be picked twice while pack is pending)
//   - auto-creates a draft PackingSlip carrying qtyPicked forward
//
// At pack time the operator records qtyPacked per line (which can
// legitimately differ from qtyPicked - e.g. damaged in handling, short
// on count, or weight-based variances). qtyPacked becomes the source
// of truth for invoicing. Only when the PackingSlip is invoiced is
// stock actually deducted from Bin.qty (and the bin reservation
// released by qtyPicked).

model PickList {
  id           String         @id @default(cuid())
  pickListNo   String         @unique
  salesOrderId String
  status       String         @default("draft") // draft | picking | picked | cancelled
  notes        String?
  createdById  String
  // Self-claim assignment: a worker on the mobile PWA taps "Claim" on
  // an unassigned task; the row is locked to that user until they
  // release it or finish picking. Null means available to everyone.
  assignedToId String?
  claimedAt    DateTime?
  pickedAt     DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  salesOrder   SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  items        PickListItem[]
  packingSlip  PackingSlip?
  assignedTo   User?          @relation("PickListAssignee", fields: [assignedToId], references: [id])

  @@index([salesOrderId])
  @@index([status])
  @@index([assignedToId])
}

model PickListItem {
  id               String          @id @default(cuid())
  pickListId       String
  salesOrderItemId String
  productId        String
  variantId        String?
  // Suggested bin (the system's first-fit choice). Operator may override.
  binId            String?
  // The qty the system suggested to pick (= remaining on SO line).
  qtyToPick        Float
  // What the warehouse actually picked. Defaults to qtyToPick on draft.
  qtyPicked        Float           @default(0)
  notes            String?
  pickList         PickList        @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  salesOrderItem   SalesOrderItem  @relation(fields: [salesOrderItemId], references: [id])
  product          Product         @relation(fields: [productId], references: [id])
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  bin              Bin?            @relation(fields: [binId], references: [id])

  @@index([pickListId])
  @@index([salesOrderItemId])
  @@index([productId])
  @@index([binId])
}

model PackingSlip {
  id                  String             @id @default(cuid())
  packingSlipNo       String             @unique
  // Random opaque token for read-only customer view via
  // /v1/public/packing-slips/:token. Useful as a delivery / dispatch note.
  shareToken          String?            @unique
  salesOrderId        String
  // Optional source pick list (a packing slip can also be created
  // directly for "skip-picking" walk-in dispatches in the future).
  pickListId          String?            @unique
  status              String             @default("open") // open | packed | invoiced | cancelled
  notes               String?
  createdById         String
  // Self-claim assignment for the mobile packing flow. Mirrors
  // PickList.assignedToId so the same UI treats both task types
  // uniformly.
  assignedToId        String?
  claimedAt           DateTime?
  // Tracking string stamped at pack-complete for ecommerce SOs.
  // Only populated when SalesOrder.source == "ecommerce". B2B slips
  // use the existing Trip / DispatchOrder flow and leave these null.
  awb                 String?
  carrier             String?
  // Optional public tracking link the operator can paste from the
  // courier portal. Surfaced verbatim on the invoice detail screen
  // so the customer-care team can deep-link customers.
  trackingUrl         String?
  // Denormalised total estimated weight (sum of container estWeightKg
  // or actualWeightKg when present) at pack-complete. Cached so trip
  // weight rollups stay O(1) per slip and we don't recompute when a
  // dispatch row is fetched.
  totalEstWeightKg    Float              @default(0)
  totalActualWeightKg Float?
  // Courier handoff lifecycle for ecommerce. dispatchedAt is set when
  // the operator (or pack-complete auto-handoff) assigns a courier;
  // deliveredAt is set when the operator marks the order delivered.
  // Both are independent of slip.status so we can still reflect
  // financial state ("invoiced") alongside fulfilment state.
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  packedAt            DateTime?
  invoicedAt          DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  salesOrder          SalesOrder         @relation(fields: [salesOrderId], references: [id])
  pickList            PickList?          @relation(fields: [pickListId], references: [id])
  items               PackingSlipItem[]
  invoice             Invoice?
  assignedTo          User?              @relation("PackingSlipAssignee", fields: [assignedToId], references: [id])
  containers          PackingContainer[]

  @@index([salesOrderId])
  @@index([status])
  @@index([assignedToId])
}

model PackingSlipItem {
  id               String                 @id @default(cuid())
  packingSlipId    String
  salesOrderItemId String
  productId        String
  variantId        String?
  // Carried forward from the PickList line for traceability. Snapshot
  // of bin id is kept on the PickListItem; we only carry numeric qty.
  qtyOrdered       Float // SO line qty at the time of pack
  qtyPicked        Float // warehouse-confirmed picked qty
  qtyPacked        Float // EDITABLE -- this is what gets invoiced
  rate             Float
  amount           Float // qtyPacked * rate (re-computed on save)
  notes            String?
  packingSlip      PackingSlip            @relation(fields: [packingSlipId], references: [id], onDelete: Cascade)
  salesOrderItem   SalesOrderItem         @relation(fields: [salesOrderItemId], references: [id])
  product          Product                @relation(fields: [productId], references: [id])
  variant          ProductVariant?        @relation(fields: [variantId], references: [id])
  invoiceItems     InvoiceItem[]
  containerEntries PackingContainerItem[]

  @@index([packingSlipId])
  @@index([salesOrderItemId])
  @@index([productId])
}

// =====================================================================
// Multi-container packing
// =====================================================================
// A packing slip can ship in one or more physical containers (boxes /
// bags / cartons / sacks). Each container has an admin-managed
// ContainerType (with default tare weight), a per-slip incremental
// label (01, 02 ...), and a list of PackingContainerItem rows that
// allocate slip-item qty to this container. One ordered item can be
// split across multiple containers - the sum of container-item qty
// per slip line must equal PackingSlipItem.qtyPacked at pack-complete
// when CompanyProfile.packMultiContainerEnabled is on.
// =====================================================================

model ContainerType {
  id         String             @id @default(cuid())
  code       String             @unique // BOX-S | BOX-M | BOX-L | BAG-S | BAG-L | CARTON | SACK
  name       String // "Small Box"
  // Physical category. Drives the icon shown to packers and lets
  // reports group by kind without parsing the code.
  // box | bag | carton | sack | other
  kind       String
  // Empty container weight in kg. Added to container estWeightKg.
  tareKg     Float              @default(0)
  // Optional soft capacity hint (kg). Not enforced; surfaces a
  // warning chip in the UI when contents exceed it.
  maxKg      Float?
  active     Boolean            @default(true)
  sortOrder  Int                @default(100)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  containers PackingContainer[]

  @@index([active])
}

model PackingContainer {
  id              String                 @id @default(cuid())
  packingSlipId   String
  // 1-based sequence per slip. Drives the label (01, 02, ...).
  // Unique within a slip; never re-used after delete (deletion shifts
  // labels via a re-number sweep so packers always see 01, 02, ... no gaps).
  seq             Int
  // Padded display label cached for stable label printing across renumbers.
  // Server keeps this in sync with seq via the renumber sweep.
  label           String
  containerTypeId String?
  // open = packer is still adding items; sealed = locked, contributes to
  // pack-complete and to dispatch weight.
  status          String                 @default("open") // open | sealed
  // Cached weight estimate: tare + sum(item.qty * variant/product.weightKg).
  // Recomputed on every container-item change.
  estWeightKg     Float                  @default(0)
  // Optional manual scale reading. When present, used in preference to
  // estWeightKg for dispatch weight rollup.
  actualWeightKg  Float?
  // Optional per-container tare override (e.g. operator wrapped the box
  // in extra cardboard). Falls back to containerType.tareKg.
  tareKgOverride  Float?
  notes           String?
  sealedAt        DateTime?
  sealedById      String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  packingSlip     PackingSlip            @relation(fields: [packingSlipId], references: [id], onDelete: Cascade)
  containerType   ContainerType?         @relation(fields: [containerTypeId], references: [id])
  items           PackingContainerItem[]

  @@unique([packingSlipId, seq])
  @@index([packingSlipId])
  @@index([status])
}

model PackingContainerItem {
  id                String           @id @default(cuid())
  containerId       String
  packingSlipItemId String
  // Allocated qty of the slip line into this container. The sum across
  // containers for a given slip-item must equal PackingSlipItem.qtyPacked
  // at pack-complete time.
  qty               Float
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  container         PackingContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  packingSlipItem   PackingSlipItem  @relation(fields: [packingSlipItemId], references: [id], onDelete: Cascade)

  @@unique([containerId, packingSlipItemId])
  @@index([containerId])
  @@index([packingSlipItemId])
}

// =====================================================================
// Approvals & Audit
// =====================================================================

model Approval {
  id          String    @id @default(cuid())
  ref         String
  type        String // PR | PO Amendment | Stock Adjust | Price Override | Production Variance
  requestedBy String
  amount      Float
  priority    String    @default("med") // low | med | high
  reason      String
  status      String    @default("pending") // pending | approved | rejected
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  before    String?
  after     String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

// =====================================================================
// Mobile warehouse: cycle counts + scan event log
// =====================================================================

// One row per recount or product-reassignment performed from the
// mobile PWA (or any client posting through /v1/bins/:id/recount).
// Pairs with a StockLedger row referenced by `ref = CC-<binCountId>`
// for monetary auditability.
model BinCount {
  id              String   @id @default(cuid())
  binId           String
  productIdBefore String?
  productIdAfter  String?
  qtyBefore       Float
  qtyAfter        Float
  // Signed delta (qtyAfter - qtyBefore). Stored explicitly so a
  // supervisor variance report can index/sort without recomputing.
  delta           Float
  reason          String // physical_match | damage | found_elsewhere | product_swap | spillage | expired | other
  remarks         String?
  countedById     String
  // Set when |delta| > 10% of qtyBefore OR > 50 units absolute, so
  // the desktop variance audit can highlight it without a hard block
  // (any worker may post; flag is for review).
  flagged         Boolean  @default(false)
  createdAt       DateTime @default(now())
  bin             Bin      @relation(fields: [binId], references: [id])
  countedBy       User     @relation(fields: [countedById], references: [id])

  @@index([binId])
  @@index([flagged])
  @@index([createdAt])
}

// Lightweight per-scan log written from the mobile camera flows.
// Used for forensics ("did the worker really scan that bin?") and
// future pick-path heatmaps. Cheap row, indexed for time-series.
model ScanEvent {
  id        String   @id @default(cuid())
  userId    String
  // What was scanned: bin | product | rack | zone | shelf | unknown.
  kind      String
  code      String
  // Free-form context, e.g. "pick:PL-2026-1003" or "verify".
  context   String?
  outcome   String // ok | mismatch | not_found
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([code])
  @@index([createdAt])
}

// Storefront visitor activity — one row per named event (pageview, add_to_cart, …).
// anonId ties anonymous sessions together; customerId links to a Customer after login.
// Written via in-process buffer (flush every 2s) — never blocks request handlers.
model CustomerActivity {
  id         String   @id @default(cuid())
  anonId     String   // persistent localStorage UUID — always present
  customerId String?  // set after successful OTP login
  sessionId  String?  // short random per-tab key (optional)
  event      String   // pageview | product_view | add_to_cart | remove_from_cart |
                      // begin_checkout | place_order | login | logout | search
  path       String?  // e.g. /category/grains-pulses-flours (max 500)
  referer    String?  // HTTP Referer header (max 500)
  productId  String?  // for product_view / add_to_cart / remove_from_cart
  meta       String?  // small JSON blob (qty, search term, …) max 512 chars
  userAgent  String?  // browser UA, capped at 200 chars
  ip         String?  // IPv4 with last octet zeroed by default (ACTIVITY_TRIM_IP)

  createdAt  DateTime @default(now())

  @@index([anonId, createdAt])
  @@index([customerId, createdAt])
  @@index([event, createdAt])
  @@index([createdAt])
}

// Append-only operational log for admin debugging (storefront, Shiprocket,
// Razorpay, OTP/SMS). Distinct from AuditLog (entity mutations) and
// ChangeLog (sync deltas).
model SystemEventLog {
  id        String   @id @default(cuid())
  level     String // error | warn | info
  source    String // shiprocket | storefront | razorpay | otp | sms | billing
  action    String // quote | order_init | order_confirm | auth | serviceability
  message   String
  context   String? // JSON — request/response summary, secrets redacted
  refId     String? // payment intent id, SO no, phone tail, etc.
  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@index([level, createdAt])
  @@index([createdAt])
}

// =====================================================================
// Sync engine
// =====================================================================

// Tracks every mutation across syncable entities so clients can pull deltas.
model ChangeLog {
  id         String   @id @default(cuid())
  entity     String // Product | Bin | StockLedger | Invoice | etc.
  entityId   String
  op         String // insert | update | delete
  payload    String // JSON snapshot
  version    Int // monotonically increasing per entity row
  serverTime DateTime @default(now())
  origin     String   @default("server") // server | client device id

  @@index([serverTime])
  @@index([entity, entityId])
}

// Tombstones for deleted rows so clients can drop local copies.
model Tombstone {
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  serverTime DateTime @default(now())

  @@unique([entity, entityId])
  @@index([serverTime])
}

// Per-device sync state.
model SyncState {
  id           String    @id @default(cuid())
  deviceId     String    @unique
  userId       String?
  lastPulledAt DateTime?
  lastPushedAt DateTime?
  cursor       Int       @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Records pushes that conflicted, for post-mortem and retry diagnostics.
model SyncConflict {
  id            String   @id @default(cuid())
  deviceId      String
  entity        String
  entityId      String
  reason        String
  clientPayload String
  serverPayload String
  resolution    String   @default("server-wins")
  createdAt     DateTime @default(now())

  @@index([deviceId])
  @@index([entity, entityId])
}

// =====================================================================
// Settings
// =====================================================================

// Configurable document numbering schemes (invoice, quote, etc.).
// Each scheme holds an atomic counter; invoices store which scheme was used.
model DocumentSeries {
  id            String     @id @default(cuid())
  code          String     @unique
  name          String
  documentType  String     @default("invoice") // invoice | quote | sales_order | credit_note
  prefix        String     @default("INV")
  // Tokens: {PREFIX} {YYYY} {YY} {FY} {MM} {SEQ}
  pattern       String     @default("{PREFIX}-{YYYY}-{SEQ}")
  padWidth      Int        @default(4)
  startNumber   Int        @default(1)
  nextNumber    Int        @default(1)
  resetPeriod   String     @default("yearly") // never | yearly | fiscal | monthly
  lastPeriodKey String?
  // Auto-route when SalesOrder.source / POS channel matches (imported, ecommerce, internal, pos).
  channelSource String?
  isDefault     Boolean    @default(false)
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  customers     Customer[]
  invoices      Invoice[]

  @@index([documentType, active])
  @@index([channelSource])
}

// Singleton row that holds the deployment's company identity.
// Used on invoices, quotes (including the public share viewer), POS receipts,
// e-Way bill payloads, and SMS sender config.
//
// We use a fixed `key` so there is exactly one row; an upsert against
// `key = "default"` is the canonical way to read/write.
model CompanyProfile {
  id                          String   @id @default(cuid())
  key                         String   @unique @default("default")
  legalName                   String
  tradeName                   String?
  gstin                       String?
  pan                         String?
  cin                         String?
  industry                    String?
  addressLine                 String?
  city                        String?
  state                       String?
  pincode                     String?
  country                     String   @default("India")
  phone                       String?
  email                       String?
  website                     String?
  logoUrl                     String?
  invoicePrefix               String   @default("INV")
  quotePrefix                 String   @default("Q")
  currency                    String   @default("INR")
  fiscalYearStart             String   @default("04-01") // MM-DD; India default = 1 Apr
  defaultTaxRate              Float    @default(18) // % GST applied if product has none
  pricingIncludesGst          Boolean  @default(false) // when true, catalog/list prices include GST
  transportGstEnabled         Boolean  @default(true) // when true, freight charges attract 18% GST
  termsDefault                String?
  bankName                    String?
  bankAccountNo               String?
  bankIfsc                    String?
  bankBranch                  String?
  upi                         String?
  // When true (default), an MO must be "released" (material shortage check
  // + replenishment TOs created) before issue-materials is allowed.
  // Set to false for plants that don't use dedicated production-line warehouses.
  requireMoReleaseBeforeIssue Boolean  @default(false)
  // When true, packing slips MUST allocate qtyPacked into one or more
  // sealed PackingContainer rows before /pack is allowed. Hides/exposes
  // the container UI on desktop + mobile pack screens.
  packMultiContainerEnabled   Boolean  @default(true)
  // When true, mobile/desktop "Seal" actions on a container open a
  // confirmation modal showing item count + est weight before locking.
  packRequireSealConfirmation Boolean  @default(true)
  // When true (default), GET pick-list responses sort lines by bin
  // zone/shelf/bin for warehouse walk-path picking. When false, lines
  // stay in sales-order / creation order until variants are mapped.
  pickSortByBinEnabled        Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// ─── Customer Returns / RMA ───────────────────────────────────────────────────

model CustomerReturn {
  id            String               @id @default(cuid())
  returnNo      String               @unique // CRN-2026-3001
  shareToken    String               @unique
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id])
  // Optional invoice anchor chosen by staff at import time. When provided the
  // system validates return qty against that invoice; otherwise it searches the
  // customer's most-recent eligible invoice for each SKU.
  invoiceId     String?
  invoice       Invoice?             @relation(fields: [invoiceId], references: [id])
  status        String               @default("pending_approval")
  // pending_approval | processed | cancelled
  source        String               @default("excel") // excel | manual
  notes         String?
  subTotal      Float                @default(0)
  tax           Float                @default(0)
  total         Float                @default(0)
  importedById  String
  finalizedById String?
  finalizedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  items         CustomerReturnItem[]
  creditNote    CreditNote?

  @@index([customerId])
  @@index([status])
}

model CustomerReturnItem {
  id               String          @id @default(cuid())
  customerReturnId String
  customerReturn   CustomerReturn  @relation(fields: [customerReturnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  // Back-link to the source invoice line so the credit-note can allocate
  // correctly and future imports can check prior-return qty.
  invoiceItemId    String?
  qty              Float
  rate             Float // taken from source invoice line, not current catalogue price
  amount           Float
  reason           String // damaged|wrong_item|defective|not_as_described|expired|changed_mind|other
  reasonNotes      String?
  decision         String          @default("pending") // pending|approved|rejected
  decisionNotes    String?
  decidedById      String?
  decidedAt        DateTime?

  @@index([customerReturnId])
  @@index([productId])
}

model CreditNote {
  id                String           @id @default(cuid())
  creditNoteNo      String           @unique // CN-2026-4001
  shareToken        String           @unique
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id])
  customerReturnId  String           @unique
  customerReturn    CustomerReturn   @relation(fields: [customerReturnId], references: [id])
  // Primary invoice this credit note offsets (may be null if goodwill credit
  // was spread across multiple invoices — invoiceId holds the first one).
  invoiceId         String?
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id])
  // Back-link to the AR payment row created during finalize.
  customerPaymentId String?          @unique
  subTotal          Float
  tax               Float
  cgstTotal         Float            @default(0)
  sgstTotal         Float            @default(0)
  igstTotal         Float            @default(0)
  taxKind           String           @default("intra") // intra | inter
  placeOfSupplyState String?
  sellerState       String?
  pricingInclusive  Boolean          @default(false)
  roundOff          Float            @default(0)
  total             Float
  status            String           @default("issued") // issued | applied
  notes             String?
  createdAt         DateTime         @default(now())
  createdById       String
  items             CreditNoteItem[]

  @@index([customerId])
  @@index([invoiceId])
}

model CreditNoteItem {
  id           String          @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote      @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  qty          Float
  rate         Float
  amount       Float
  taxableValue Float?
  gstRate      Float?          @default(18)
  taxAmount    Float?
  cgstAmount   Float?
  sgstAmount   Float?
  igstAmount   Float?
  reason       String
  returnItemId String? // back-link to the source CustomerReturnItem

  @@index([creditNoteId])
}
