<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NovaErp.ViewModels"
             xmlns:views="using:NovaErp.Views"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="700"
             x:Class="NovaErp.Views.WarehouseStationView"
             x:DataType="vm:WarehouseStationViewModel">
  <UserControl.Resources>
    <views:StringEqualsConverter x:Key="StringEquals" />
  </UserControl.Resources>

  <Grid Margin="20" RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Spacing="6">
      <TextBlock Classes="caption" Text="WAREHOUSE OPERATION" />
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="h1" Text="Fast Transfer" />
          <TextBlock Classes="muted" Text="Scan → Source → Destination → Qty → Complete" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="chip" Background="{DynamicResource Primary50Brush}">
            <TextBlock Text="{Binding Step}" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
          </Border>
          <Button Classes="secondary" Content="Reset" Command="{Binding ResetCommand}" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0 24 0 0" ColumnDefinitions="2*,*" >
      <!-- Left: scan workflow -->
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="16">
          <!-- Scan input -->
          <StackPanel Spacing="6">
            <TextBlock Text="Scanner / SKU input" Classes="caption" />
            <TextBox Classes="scan" Text="{Binding ScanCode}"
                     Watermark="Scan barcode or type SKU then press Enter…"
                     KeyDown="ScanKeyDown" />
          </StackPanel>

          <!-- Steps -->
          <UniformGrid Columns="3">
            <Border Classes="card" Padding="14" Margin="0 0 8 0">
              <StackPanel Spacing="6">
                <TextBlock Text="1. Product" Classes="caption" />
                <TextBlock Text="{Binding ProductSku}" FontFamily="Consolas" FontSize="12" Classes="muted" />
                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="14" Margin="4 0">
              <StackPanel Spacing="6">
                <TextBlock Text="2. Source bin" Classes="caption" />
                <TextBlock Text="{Binding SourceBin}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="14" Margin="8 0 0 0">
              <StackPanel Spacing="6">
                <TextBlock Text="3. Destination bin" Classes="caption" />
                <TextBlock Text="{Binding DestBin}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Qty + complete -->
          <Grid ColumnDefinitions="200,*,Auto">
            <StackPanel Spacing="6">
              <TextBlock Text="4. Quantity" Classes="caption" />
              <TextBox Classes="input" Text="{Binding Qty}" FontSize="20" FontWeight="Bold" />
            </StackPanel>
            <Border Grid.Column="1" Margin="16 22 16 0" Padding="12" CornerRadius="8"
                    Background="{DynamicResource Primary50Brush}">
              <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
            </Border>
            <Button Grid.Column="2" Classes="primary" Margin="0 22 0 0"
                    Content="Complete · F8" Command="{Binding CompleteCommand}"
                    HotKey="F8" />
          </Grid>

          <TextBlock Classes="caption">
            <Run Text="Tips: " /><Run Text="Esc resets · F2 jumps to scanner · F8 confirms transfer · works fully offline."
                                       FontStyle="Italic" />
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Right: recent scans + status -->
      <StackPanel Grid.Column="1" Margin="16 0 0 0" Spacing="16">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Recent scans" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding RecentScans}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10" Margin="0 0 0 6" CornerRadius="6" Background="{DynamicResource CanvasBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="36" Height="36" CornerRadius="6"
                              Background="{DynamicResource Primary50Brush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Uom}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10 0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Sku}" FontFamily="Consolas" FontSize="11" Classes="muted" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding StockOnHand}"
                                 FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption" Text="No scans yet. Scan to populate."
                       IsVisible="{Binding !RecentScans.Count}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
