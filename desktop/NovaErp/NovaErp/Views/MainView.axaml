<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NovaErp.ViewModels"
             xmlns:views="using:NovaErp.Views"
             xmlns:services="using:NovaErp.Services"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="780"
             x:Class="NovaErp.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <views:StringEqualsConverter x:Key="StringEquals" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Highlight nav button when its CommandParameter matches ActiveNav -->
    <Style Selector="Button.nav-active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ContentControl Content="{Binding Login}" IsVisible="{Binding !IsAuthenticated}" />

    <DockPanel IsVisible="{Binding IsAuthenticated}">
      <!-- Top command bar -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0 0 0 1"
              Height="56">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="16 0">
            <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
              <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="18"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="NovaERP" FontWeight="Bold" FontSize="15" />
              <TextBlock Text="Floor Console · Desktop" Classes="caption" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Classes="chip primary">
              <TextBlock Text="WH-MAIN · Pune" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <Border Classes="chip">
              <TextBlock Text="Shift A" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="0 0 16 0" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding UserRole}" Classes="caption" HorizontalAlignment="Right" />
            </StackPanel>
            <Button Classes="ghost" Content="Sign out" Command="{Binding LogoutCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Bottom status bar -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource PrimaryBrush}" Height="28">
        <Grid ColumnDefinitions="*,Auto" Margin="14 0">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Foreground="White" FontSize="11" VerticalAlignment="Center">
              <Run Text="Sync: " /><Run Text="{Binding SyncStatus}" />
            </TextBlock>
            <TextBlock Foreground="White" FontSize="11" VerticalAlignment="Center">
              <Run Text="Outbox: " /><Run Text="{Binding OutboxCount}" />
            </TextBlock>
            <TextBlock Foreground="White" FontSize="11" VerticalAlignment="Center" Text="{Binding Source={x:Static services:AppSettings.DeviceId}, StringFormat='Device: {0}'}" />
          </StackPanel>
          <Button Grid.Column="1" Foreground="White" Background="Transparent" Padding="14 0" Height="22"
                  Content="Sync now" Command="{Binding SyncNowCommand}" />
        </Grid>
      </Border>

      <!-- Sidebar + content -->
      <Grid ColumnDefinitions="208,*">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0 0 1 0">
          <StackPanel Margin="8" Spacing="2">
            <Button Classes="nav" Content="Warehouse Station"
                    Classes.nav-active="{Binding ActiveNav, Converter={StaticResource StringEquals}, ConverterParameter='warehouse'}"
                    Command="{Binding NavigateToCommand}" CommandParameter="warehouse" />
            <Button Classes="nav" Content="Manufacturing"
                    Classes.nav-active="{Binding ActiveNav, Converter={StaticResource StringEquals}, ConverterParameter='manufacturing'}"
                    Command="{Binding NavigateToCommand}" CommandParameter="manufacturing" />
            <Button Classes="nav" Content="Dispatch"
                    Classes.nav-active="{Binding ActiveNav, Converter={StaticResource StringEquals}, ConverterParameter='dispatch'}"
                    Command="{Binding NavigateToCommand}" CommandParameter="dispatch" />
            <Button Classes="nav" Content="Attendance"
                    Classes.nav-active="{Binding ActiveNav, Converter={StaticResource StringEquals}, ConverterParameter='attendance'}"
                    Command="{Binding NavigateToCommand}" CommandParameter="attendance" />
          </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
