<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NovaErp.ViewModels"
             xmlns:views="using:NovaErp.Views"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="780"
             x:Class="NovaErp.Views.MobileMainView"
             x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <views:StringEqualsConverter x:Key="StringEquals" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tab.active TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.tab.active TextBlock.icon">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.icon">
      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ContentControl Content="{Binding Login}" IsVisible="{Binding !IsAuthenticated}" />

    <DockPanel IsVisible="{Binding IsAuthenticated}">
      <!-- Compact top bar -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryBrush}" Height="48">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="14 0">
          <TextBlock Text="NovaERP" Foreground="White" FontWeight="Bold" FontSize="16"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Foreground="White" FontSize="11"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Text="{Binding UserName, StringFormat='{}{0} · WH-MAIN'}" />
          <TextBlock Grid.Column="2" Foreground="White" FontSize="11" VerticalAlignment="Center"
                     Text="{Binding SyncStatus}" />
        </Grid>
      </Border>

      <!-- Bottom tab bar -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0 1 0 0"
              Height="64">
        <UniformGrid Columns="4">
          <Button Classes="tab"
                  Classes.active="{Binding ActiveNav, Converter={StaticResource StringEquals}, ConverterParameter='warehouse'}"
                  Command="{Binding NavigateToCommand}" CommandParameter="warehouse">
            <StackPanel>
              <TextBlock Classes="icon" Text="📦" />
              <TextBlock Classes="label" Text="Scan" />
            </StackPanel>
          </Button>
          <Button Classes="tab"
                  Classes.active="{Binding ActiveNav, Converter={StaticResource StringEquals}, ConverterParameter='manufacturing'}"
                  Command="{Binding NavigateToCommand}" CommandParameter="manufacturing">
            <StackPanel>
              <TextBlock Classes="icon" Text="🏭" />
              <TextBlock Classes="label" Text="Mfg" />
            </StackPanel>
          </Button>
          <Button Classes="tab"
                  Classes.active="{Binding ActiveNav, Converter={StaticResource StringEquals}, ConverterParameter='dispatch'}"
                  Command="{Binding NavigateToCommand}" CommandParameter="dispatch">
            <StackPanel>
              <TextBlock Classes="icon" Text="🚚" />
              <TextBlock Classes="label" Text="Dispatch" />
            </StackPanel>
          </Button>
          <Button Classes="tab"
                  Classes.active="{Binding ActiveNav, Converter={StaticResource StringEquals}, ConverterParameter='attendance'}"
                  Command="{Binding NavigateToCommand}" CommandParameter="attendance">
            <StackPanel>
              <TextBlock Classes="icon" Text="🪪" />
              <TextBlock Classes="label" Text="Punch" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </Border>

      <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
  </Grid>
</UserControl>
