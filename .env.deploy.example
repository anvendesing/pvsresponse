# =====================================================================
# NovaERP - deployment environment variables
# =====================================================================
# Copy this file to `.env` (same directory as docker-compose.yml) and
# tweak the values you care about. docker-compose reads `.env`
# automatically; everything else has sensible defaults.
# =====================================================================

# ----------- REQUIRED -----------

# Long random string used to sign JWTs. Generate with:
#   openssl rand -hex 64
# Anything you put here MUST be kept secret. Rotating it logs every
# user out (and invalidates active share links that contain a JWT).
JWT_SECRET=replace-me-with-openssl-rand-hex-64-output

# PostgreSQL password. Generate with:
#   openssl rand -hex 32
POSTGRES_PASSWORD=replace-me-with-openssl-rand-hex-32-output

# GitHub user or org that owns the GHCR images (lowercase).
# Used by docker-compose.prod.yml to pull pre-built images from GHCR.
# Must match the account that pushed images via CI (build-images.yml).
REGISTRY_OWNER=anvendesing

# Docker image tag to deploy. "latest" always tracks the tip of main.
# Pin to a specific commit tag (e.g. sha-1a2b3c4) for rollback safety.
IMAGE_TAG=latest

# ----------- OPTIONAL -----------

# Public host port the SPA + API are reachable on. 80 (default) means
# users hit http://<VPS_IP>/ directly. Use 8080 if your VPS already
# runs something on :80.
WEB_PORT=80

# Public host port for the Prakruthivanam ecommerce storefront.
# Default 8080 so ERP (WEB_PORT) and shop can run side-by-side on one VPS.
# Open this port in your firewall alongside WEB_PORT.
SHOP_PORT=8080

# PostgreSQL connection URL (Docker internal network).
# The database name, user, and host are set by the postgres service above.
DATABASE_URL=postgresql://novaerp:${POSTGRES_PASSWORD}@postgres:5432/novaerp?schema=public

# Redis connection URL (Docker internal network).
REDIS_URL=redis://redis:6379/0

# Allowed CORS origins for /v1/*. "*" lets any origin call the API
# (fine when the only writer is the same-origin SPA). Pin this once
# you have a list of known consumers (e.g. a separate dashboard).
CORS_ORIGIN=*

# Override only if the SPA must talk to a backend on a DIFFERENT
# origin (e.g. a separate api.example.com domain). Leave blank for
# the default same-origin / IP-only deployment.
VITE_API_URL=
