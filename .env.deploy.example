# =============================================================================
# NovaERP — Production deployment environment template
# =============================================================================
# Copy this file to .env on the VPS and fill in the values marked REQUIRED.
#
#   cp .env.deploy.example .env
#   nano .env    # or vim, vi, etc.
#
# Variables marked (auto-generated) are set by the migration script if left
# blank. Everything else has a safe default for a standard IP-only deploy.
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────

# Long random string for signing JWTs.  Generate with:  openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64

# Password for the internal Postgres container.  Generate with:  openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Database (leave as-is for standard Docker Compose deploy) ─────────────────

# Points at the postgres service inside the docker-compose network.
# Only change the hostname if you use an external / managed Postgres.
DATABASE_URL=postgresql://novaerp:${POSTGRES_PASSWORD}@postgres:5432/novaerp?schema=public

# ── Redis cache ───────────────────────────────────────────────────────────────

# Points at the redis service inside the docker-compose network.
# Omit to disable Redis gracefully (storefront will run without caching).
REDIS_URL=redis://redis:6379/0

# ── Port mapping ─────────────────────────────────────────────────────────────

# Host port for the ERP admin portal (nginx).  Default: 80
WEB_PORT=80

# Host port for the Prakruthivanam ecommerce storefront (nginx).  Default: 8080
SHOP_PORT=8080

# ── CORS / origin (usually leave blank for IP-only) ──────────────────────────

# Allowed CORS origins for the API.  * = allow all (fine for IP-only VPS).
# When you add a domain, you can tighten this:  https://myshop.example.com
CORS_ORIGIN=*

# URL the browser uses to reach the API.
# Leave blank if the SPA is served by the same nginx (same-origin proxy).
# Set to http://<VPS_IP> or https://api.example.com if the API is a different origin.
VITE_API_URL=

# ── Ecommerce storefront token ────────────────────────────────────────────────

# The storefront uses a pre-shared bearer token for public catalog reads.
# Generate a random value and paste it here; then set the same value in the
# ERP under Settings → Storefront.
# Generate:  openssl rand -hex 32
VITE_MOCK_STOREFRONT_TOKEN=

# ── Optional: GHCR image registry (for CI-built images) ─────────────────────
# Uncomment when deploying prebuilt images instead of building on the VPS.
# See DEPLOYMENT.md §11 for the full CI workflow.
# REGISTRY_OWNER=your-github-username-lowercase
# IMAGE_TAG=latest

# ── Optional: payment gateway (configure in ERP Settings → Payment instead) ──
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PAYU_MERCHANT_KEY=
# PAYU_SALT=
# PAYU_MODE=test

# ── Optional: shipping (configure in ERP Settings → Shipping instead) ────────
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_PINCODE=517132
