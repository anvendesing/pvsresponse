<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Brand tokens. Sourced from pvsecommerce/src/styles/theme.css :root.
       Keep these in sync if the React app's theme is ever revised. -->

  <!-- Brand: gold -->
  <Color x:Key="BrandGoldColor">#F0C238</Color>
  <Color x:Key="BrandGoldDarkColor">#DCA31F</Color>
  <Color x:Key="BrandGoldLightColor">#FEF08A</Color>
  <Color x:Key="BrandGoldCreamColor">#FEFCF3</Color>
  <Color x:Key="BrandGoldSoftColor">#FEF3C7</Color>

  <SolidColorBrush x:Key="BrandGold" Color="{StaticResource BrandGoldColor}" />
  <SolidColorBrush x:Key="BrandGoldDark" Color="{StaticResource BrandGoldDarkColor}" />
  <SolidColorBrush x:Key="BrandGoldLight" Color="{StaticResource BrandGoldLightColor}" />
  <SolidColorBrush x:Key="BrandGoldCream" Color="{StaticResource BrandGoldCreamColor}" />
  <SolidColorBrush x:Key="BrandGoldSoft" Color="{StaticResource BrandGoldSoftColor}" />

  <!-- Brand: forest -->
  <Color x:Key="BrandForestColor">#385F1C</Color>
  <Color x:Key="BrandForestLightColor">#4C7B2A</Color>
  <Color x:Key="BrandForestDarkColor">#233E11</Color>
  <Color x:Key="BrandForestSoftColor">#F1F8EC</Color>

  <SolidColorBrush x:Key="BrandForest" Color="{StaticResource BrandForestColor}" />
  <SolidColorBrush x:Key="BrandForestLight" Color="{StaticResource BrandForestLightColor}" />
  <SolidColorBrush x:Key="BrandForestDark" Color="{StaticResource BrandForestDarkColor}" />
  <SolidColorBrush x:Key="BrandForestSoft" Color="{StaticResource BrandForestSoftColor}" />

  <!-- Neutrals -->
  <Color x:Key="NeutralDarkColor">#22251F</Color>
  <Color x:Key="NeutralGrayColor">#78716C</Color>
  <Color x:Key="NeutralLightColor">#FAFAF9</Color>
  <Color x:Key="NeutralWhiteColor">#FFFFFF</Color>
  <Color x:Key="NeutralCreamColor">#FDFAF2</Color>

  <SolidColorBrush x:Key="NeutralDark" Color="{StaticResource NeutralDarkColor}" />
  <SolidColorBrush x:Key="NeutralGray" Color="{StaticResource NeutralGrayColor}" />
  <SolidColorBrush x:Key="NeutralLight" Color="{StaticResource NeutralLightColor}" />
  <SolidColorBrush x:Key="NeutralWhite" Color="{StaticResource NeutralWhiteColor}" />
  <SolidColorBrush x:Key="NeutralCream" Color="{StaticResource NeutralCreamColor}" />

  <!-- Status -->
  <SolidColorBrush x:Key="StatusSuccess" Color="#16A34A" />
  <SolidColorBrush x:Key="StatusError" Color="#DC2626" />
  <SolidColorBrush x:Key="StatusWarning" Color="#CA8A04" />

  <!-- Geometry -->
  <CornerRadius x:Key="RadiusSm">8</CornerRadius>
  <CornerRadius x:Key="RadiusMd">16</CornerRadius>
  <CornerRadius x:Key="RadiusLg">24</CornerRadius>
  <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

  <Thickness x:Key="PadXs">4</Thickness>
  <Thickness x:Key="PadSm">8</Thickness>
  <Thickness x:Key="PadMd">16</Thickness>
  <Thickness x:Key="PadLg">24</Thickness>

  <!-- Shadows (Avalonia BoxShadows: offsetX, offsetY, blur, spread, color) -->
  <BoxShadows x:Key="ShadowSm">0 2 4 0 #0F22251F</BoxShadows>
  <BoxShadows x:Key="ShadowMd">0 4 14 0 #1422251F</BoxShadows>
  <BoxShadows x:Key="ShadowLg">0 10 30 0 #1F22251F</BoxShadows>
</ResourceDictionary>
