<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PvsCommerce.Mobile.ViewModels"
        xmlns:views="using:PvsCommerce.Mobile.Views"
        x:Class="PvsCommerce.Mobile.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Prakruthivanam"
        Width="410" Height="840"
        MinWidth="360" MinHeight="640"
        Background="{StaticResource NeutralCream}">
  <views:MainView DataContext="{Binding}" />
</Window>
