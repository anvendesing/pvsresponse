<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PvsCommerce.Mobile.ViewModels"
             x:Class="PvsCommerce.Mobile.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="16">

      <StackPanel Spacing="4">
        <TextBlock Text="API Settings" Classes="h2" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Point the app at your backend. Production VPS: http://217.216.78.119/v1. Emulator: http://10.0.2.2:4000/v1. Real phone on LAN: http://192.168.x.x:4000/v1." />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="API base URL" FontWeight="SemiBold" />
        <TextBox Text="{Binding ApiBaseUrl, Mode=TwoWay}"
                 Watermark="http://217.216.78.119/v1"
                 FontSize="14" />
      </StackPanel>

      <StackPanel Spacing="2">
        <TextBlock Text="Image origin (auto-derived)" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ImageOrigin}" Classes="muted" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="Save &amp; Test"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Classes="outline" Content="Use production VPS"
                Command="{Binding UseProductionServerCommand}" />
        <Button Classes="outline" Content="Reset to default"
                Command="{Binding ResetToDefaultCommand}" />
      </StackPanel>

      <Border Classes="card" Background="{StaticResource BrandForestSoft}"
              IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Spacing="6">
        <TextBlock Text="Quick setup" FontWeight="SemiBold" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Production VPS (recommended): tap 'Use production VPS' above — works from any network, no extra setup needed." />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Local dev (LAN): backend must bind to 0.0.0.0:4000. Find your PC's LAN IP via 'ipconfig' (e.g. 192.168.x.x). Phone and PC must share the same Wi-Fi." />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Android emulator: use http://10.0.2.2:4000/v1 (emulator's special address for the host machine)." />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Cleartext (http://) traffic is already enabled, so no TLS setup is needed." />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
