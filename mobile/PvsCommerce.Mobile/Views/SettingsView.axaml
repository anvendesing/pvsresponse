<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PvsCommerce.Mobile.ViewModels"
             x:Class="PvsCommerce.Mobile.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="16">

      <StackPanel Spacing="4">
        <TextBlock Text="API Settings" Classes="h2" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Point the app at your backend. Use http://10.0.2.2:4000/v1 for the Android emulator, or your dev machine's LAN IP (e.g. http://192.168.1.10:4000/v1) when running on a real phone." />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="API base URL" FontWeight="SemiBold" />
        <TextBox Text="{Binding ApiBaseUrl, Mode=TwoWay}"
                 Watermark="http://192.168.1.10:4000/v1"
                 FontSize="14" />
      </StackPanel>

      <StackPanel Spacing="2">
        <TextBlock Text="Image origin (auto-derived)" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ImageOrigin}" Classes="muted" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="Save &amp; Test"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Classes="outline" Content="Reset to default"
                Command="{Binding ResetToDefaultCommand}" />
      </StackPanel>

      <Border Classes="card" Background="{StaticResource BrandForestSoft}"
              IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Spacing="6">
        <TextBlock Text="Setup checklist" FontWeight="SemiBold" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="1. Start the backend and bind it to 0.0.0.0:4000 (not just localhost) so other devices on your network can reach it." />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="2. Find your dev machine's LAN IP: run 'ipconfig' on Windows and look for IPv4 Address (typically 192.168.x.x)." />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="3. Phone and PC must be on the same Wi-Fi network." />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="4. The app already allows cleartext (http://) traffic, so no TLS setup is required." />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
