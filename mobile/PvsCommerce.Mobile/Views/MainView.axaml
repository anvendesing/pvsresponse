<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PvsCommerce.Mobile.ViewModels"
             xmlns:views="using:PvsCommerce.Mobile.Views"
             xmlns:conv="using:PvsCommerce.Mobile.Converters"
             x:Class="PvsCommerce.Mobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource NeutralCream}">

  <Grid>
    <!-- ── Main app surface (header / content / bottom nav) ──────── -->
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Header: brand mark + cart badge -->
      <Border Grid.Row="0"
              Background="{StaticResource NeutralWhite}"
              BorderBrush="{StaticResource NeutralBorder}"
              BorderThickness="0,0,0,1"
              Padding="16,14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Classes="icon" Padding="0"
                  Command="{Binding SwitchTabCommand}" CommandParameter="shop">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Background="{StaticResource ForestGreen}"
                      CornerRadius="9999" Width="34" Height="34">
                <TextBlock Text="🌿" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
              </Border>
              <StackPanel Spacing="-2" VerticalAlignment="Center">
                <TextBlock Text="Prakruthivanam" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource ForestGreenDark}" />
                <TextBlock Text="Farm-direct organic" FontSize="10"
                           Foreground="{StaticResource NeutralGray}" />
              </StackPanel>
            </StackPanel>
          </Button>

          <Button Grid.Column="2" Classes="icon"
                  Command="{Binding SwitchTabCommand}" CommandParameter="cart"
                  Padding="0" Width="42" Height="42">
            <Grid>
              <TextBlock Text="🛒" FontSize="18"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border Background="{StaticResource StatusError}"
                      CornerRadius="9999"
                      Width="18" Height="18"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,-2,-2,0"
                      IsVisible="{Binding Cart.Count,
                                          Converter={x:Static conv:GreaterThanZeroConverter.Instance}}">
                <TextBlock Text="{Binding Cart.Count}"
                           FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource NeutralWhite}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Button>
        </Grid>
      </Border>

      <!-- Content area: each ContentControl stays in the MainViewModel
           binding context (it merely *displays* the inner VM via Content),
           so IsVisible binds cleanly to the IsXxx flags here. The
           Application-level DataTemplates pick the right View per VM type. -->
      <Grid Grid.Row="1">
        <ContentControl Content="{Binding Shop}"    IsVisible="{Binding IsShop}" />
        <ContentControl Content="{Binding Explore}" IsVisible="{Binding IsExplore}" />
        <ContentControl Content="{Binding CartTab}" IsVisible="{Binding IsCart}" />
        <ContentControl Content="{Binding Profile}" IsVisible="{Binding IsProfile}" />
        <ContentControl Content="{Binding AuthTab}" IsVisible="{Binding IsAuth}" />
      </Grid>

      <!-- Bottom navigation -->
      <Border Grid.Row="2"
              Background="{StaticResource NeutralWhite}"
              BorderBrush="{StaticResource NeutralBorder}"
              BorderThickness="0,1,0,0"
              Padding="0,6"
              IsVisible="{Binding BottomNavVisible}">
        <Grid ColumnDefinitions="*,*,*,*">
          <Button Grid.Column="0" Classes="navItem"
                  Command="{Binding SwitchTabCommand}" CommandParameter="shop">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="🏠" FontSize="20" HorizontalAlignment="Center" />
              <TextBlock Text="Shop" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Grid.Column="1" Classes="navItem"
                  Command="{Binding SwitchTabCommand}" CommandParameter="explore">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="🔍" FontSize="20" HorizontalAlignment="Center" />
              <TextBlock Text="Explore" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Grid.Column="2" Classes="navItem"
                  Command="{Binding SwitchTabCommand}" CommandParameter="cart">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="🛒" FontSize="20" HorizontalAlignment="Center" />
              <TextBlock Text="Cart" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Grid.Column="3" Classes="navItem"
                  Command="{Binding SwitchTabCommand}" CommandParameter="profile">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" />
              <TextBlock Text="Profile" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- ── Modal sheets (overlay on top of everything). Same trick:
         ContentControl Content drives the sub-view via DataTemplate,
         IsVisible stays in the parent MainViewModel context. -->
    <ContentControl Content="{Binding Checkout}" IsVisible="{Binding Checkout.IsOpen}" />
    <ContentControl Content="{Binding Tracker}"  IsVisible="{Binding Tracker.IsOpen}" />
  </Grid>
</UserControl>
