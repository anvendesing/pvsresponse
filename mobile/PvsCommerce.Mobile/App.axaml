<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PvsCommerce.Mobile.ViewModels"
             xmlns:views="using:PvsCommerce.Mobile.Views"
             x:Class="PvsCommerce.Mobile.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="BodyFont">avares://Avalonia.Fonts.Inter/Assets/Fonts/Inter#Inter</FontFamily>
      <FontFamily x:Key="DisplayFont">avares://Avalonia.Fonts.Inter/Assets/Fonts/Inter#Inter</FontFamily>

      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PvsCommerce.Mobile/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- DataTemplate routing: ContentControl resolves the correct view when
       CurrentPage is set to a given ViewModel type. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:CategoryViewModel">
      <views:CategoryView />
    </DataTemplate>
    <DataTemplate DataType="vm:ProductDetailViewModel">
      <views:ProductDetailView />
    </DataTemplate>
    <DataTemplate DataType="vm:CartViewModel">
      <views:CartView />
    </DataTemplate>
    <DataTemplate DataType="vm:CheckoutViewModel">
      <views:CheckoutView />
    </DataTemplate>
    <DataTemplate DataType="vm:LoginViewModel">
      <views:LoginView />
    </DataTemplate>
    <DataTemplate DataType="vm:AccountViewModel">
      <views:AccountView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PvsCommerce.Mobile/Styles/Components.axaml" />
  </Application.Styles>
</Application>
