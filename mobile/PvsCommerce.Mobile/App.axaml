<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PvsCommerce.Mobile.ViewModels"
             xmlns:views="using:PvsCommerce.Mobile.Views"
             x:Class="PvsCommerce.Mobile.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PvsCommerce.Mobile/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Global view-model → view mappings. ContentControl picks the right
       view for a given Content type without us juggling ancestor bindings. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:ShopViewModel"><views:ShopView /></DataTemplate>
    <DataTemplate DataType="vm:ExploreViewModel"><views:ExploreView /></DataTemplate>
    <DataTemplate DataType="vm:CartViewModel"><views:CartView /></DataTemplate>
    <DataTemplate DataType="vm:ProfileViewModel"><views:ProfileView /></DataTemplate>
    <DataTemplate DataType="vm:AuthViewModel"><views:AuthView /></DataTemplate>
    <DataTemplate DataType="vm:CheckoutViewModel"><views:CheckoutSheet /></DataTemplate>
    <DataTemplate DataType="vm:TrackerViewModel"><views:TrackerSheet /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PvsCommerce.Mobile/Styles/Components.axaml" />
  </Application.Styles>
</Application>
