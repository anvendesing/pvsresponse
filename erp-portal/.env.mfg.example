# Manufacturing Capacitor APK build config.
# Copy to .env.mfg (gitignored) before `npm run build:mfg`.
#
# The Prakruthivanam Manufacturing APK bundles web assets locally and
# calls this origin for /v1, /health, and /uploads. Same backend as
# the warehouse APK — both share the production server.

# Production VPS (nginx on :80 proxies /v1 to backend)
VITE_API_URL=http://217.216.78.119

# Local dev on same Wi-Fi (uncomment and set your PC's LAN IP):
# VITE_API_URL=http://192.168.1.X:4000
